@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <div class="top-row px-3 bg-success">
            <img src="icons/favicon-32x32.png" />
            <div class="top-title px-2">Interception</div>
        </div>

        <article class="content px-2 px-md-3">
            @Body
        </article>
    </main>
</div>

<ToastContainer />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
