@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page @(IsHomePage ? "page-home" : string.Empty)">
    @if (!IsHomePage)
    {
        <aside class="sidebar">
            <NavMenu />
        </aside>
    }

    <main>
        <div class="top-row px-3 bg-success">
            <img src="icons/favicon-32x32.png" />
            <div class="top-title px-2">Interception</div>
        </div>

        <article class="content px-2 px-md-3">
            @Body
        </article>
    </main>
</div>

@code {
    private bool IsHomePage
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
            return string.IsNullOrWhiteSpace(relativePath);
        }
    }
}

<ToastContainer />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
