@page "/catalogs/actions"
@using Interception.UI.Domain
@using Interception.UI.Components.Pages.Catalogs.Drawers
@namespace Interception.UI.Components.Pages.Catalogs

<PageTitle>Каталог дій</PageTitle>

<div class="d-flex flex-column h-100">

    <!-- Toolbar -->
    <div class="registry-toolbar flex-shrink-0">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
                <i class="bi bi-plus-lg me-1"></i>Додати дію
            </button>
        </div>
        <div class="registry-toolbar-meta">
            @if (_actions is not null)
            {
                <span>Всього: <strong>@_actions.Count</strong></span>
            }
        </div>
    </div>

    <!-- Список -->
    <div class="flex-grow-1 overflow-auto">
        @if (_loading)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
            </div>
        }
        else if (_actions is null || _actions.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-collection fs-1 d-block mb-2 opacity-25"></i>
                <div>Дій ще немає</div>
                <button class="btn btn-link btn-sm mt-1" @onclick="OpenCreate">
                    Додати першу дію
                </button>
            </div>
        }
        else
        {
            <table class="table table-sm table-hover align-middle mb-0">
                <thead style="position:sticky;top:0;z-index:1;" class="table-dark">
                    <tr>
                        <th>Назва</th>
                        <th>Опис</th>
                        <th style="width:64px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var action in _actions)
                    {
                        <tr class="registry-row">
                            <td class="fw-medium">@action.Name</td>
                            <td class="text-muted small">
                                @if (string.IsNullOrWhiteSpace(action.Description))
                                {
                                    <span class="opacity-50">—</span>
                                }
                                else
                                {
                                    @action.Description
                                }
                            </td>
                            <td class="text-end pe-2">
                                <button class="btn btn-outline-secondary btn-sm py-0 px-1"
                                        title="Редагувати"
                                        @onclick="() => OpenEdit(action)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<ActionFormDrawer @bind-IsOpen="_drawerOpen"
                  EditingAction="_editingAction"
                  OnSaved="LoadAsync" />
