@using Interception.UI.Domain
@using Interception.UI.Components.Shared.Drawer
@namespace Interception.UI.Components.Pages.Catalogs.Drawers

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="@(EditingAction is null ? "Нова дія" : "Редагування дії")"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        <div class="row g-3">

            <div class="col-12">
                <label class="form-label form-label-sm">
                    Назва <span class="text-danger">*</span>
                </label>
                <input type="text"
                       class="form-control @(_nameError ? "is-invalid" : "")"
                       placeholder="напр. доповідь по обстановці"
                       value="@_name"
                       @oninput="e => { _name = e.Value?.ToString(); _nameError = false; }"
                       maxlength="100" />
                @if (_nameError)
                {
                    <div class="invalid-feedback">Назва обов'язкова</div>
                }
                <div class="form-text text-muted">
                    @(_name?.Length ?? 0) / 100
                </div>
            </div>

            <div class="col-12">
                <label class="form-label form-label-sm">Опис</label>
                <textarea class="form-control form-control-sm"
                          rows="3"
                          placeholder="Короткий опис коли застосовується ця дія…"
                          value="@_description"
                          @oninput="e => _description = e.Value?.ToString()"
                          maxlength="500"></textarea>
                <div class="form-text text-muted">
                    @(_description?.Length ?? 0) / 500
                </div>
            </div>

            @if (_serverError is not null)
            {
                <div class="col-12">
                    <div class="alert alert-danger py-2 px-3 mb-0 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>@_serverError
                    </div>
                </div>
            }

        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_saving">
            Скасувати
        </button>
        <button class="btn btn-primary btn-sm"
                @onclick="SaveAsync"
                disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            @(EditingAction is null ? "Створити" : "Зберегти")
        </button>
    </FooterContent>
</Drawer>
