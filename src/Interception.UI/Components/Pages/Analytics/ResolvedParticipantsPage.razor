@page "/analytics/resolved"
@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Components.Pages.Analytics.Drawers
@namespace Interception.UI.Components.Pages.Analytics

<PageTitle>Встановлені особи</PageTitle>

<div class="page-shell">

    <div class="registry-toolbar flex-shrink-0">
        <div class="registry-toolbar-meta">
            @if (_participants is not null)
            {
                <span>Всього: <strong>@_participants.Count</strong></span>
            }
        </div>
    </div>

    <div class="page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_participants is null || _participants.Count == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-person-check fs-1 d-block mb-2 opacity-25"></i>
                    <div>Підтверджених осіб ще немає</div>
                    <div class="small mt-1">Підтвердження виконуються на сторінці <a href="/analytics/candidates">аналітики</a></div>
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover table-sm align-middle data-table">
                    <thead>
                        <tr>
                            <th>Позивний</th>
                            <th>Роль</th>
                            <th>Підрозділ</th>
                            <th>Підтверджено</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _participants)
                        {
                            var participant = p;
                            <tr>
                                <td class="fw-medium">@participant.Name</td>
                                <td class="small text-muted">@(participant.Role ?? "—")</td>
                                <td class="small text-muted">
                                    <span class="text-truncate d-block" style="max-width: 200px" title="@participant.Division">
                                        @(participant.Division ?? "—")
                                    </span>
                                </td>
                                <td class="small text-muted text-nowrap">@participant.ConfirmedBy · @participant.ConfirmedAt.ToString("dd.MM.yy")</td>
                                <td class="text-end pe-2 text-nowrap">
                                    <button class="btn btn-secondary btn-sm"
                                            title="Редагувати"
                                            @onclick="() => OpenEdit(participant)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<ResolvedParticipantDrawer @bind-IsOpen="_drawerOpen"
                           Participant="_editingParticipant"
                           OnSaved="LoadAsync" />
