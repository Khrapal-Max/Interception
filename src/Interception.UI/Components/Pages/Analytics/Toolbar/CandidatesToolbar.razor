<div class="registry-toolbar analytics-toolbar flex-shrink-0">
    <div class="toolbar-start d-flex align-items-center gap-2 flex-wrap">
        @if (ActiveSection == "groups")
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/candidates"
                     Match="NavLinkMatch.All"
                     title="Групи на розгляд"
                     aria-label="Групи на розгляд">
                <i class="bi bi-collection"></i>
                <span class="visually-hidden">Групи на розгляд</span>
            </NavLink>
        }
        else
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/candidates"
                     title="Групи на розгляд"
                     aria-label="Групи на розгляд">
                <i class="bi bi-collection"></i>
                <span class="visually-hidden">Групи на розгляд</span>
            </NavLink>
        }

        @if (ActiveSection == "link-map")
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/link-map"
                     Match="NavLinkMatch.All"
                     title="Карта зв'язків"
                     aria-label="Карта зв'язків">
                <i class="bi bi-bezier2"></i>
                <span class="visually-hidden">Карта зв'язків</span>
            </NavLink>
        }
        else
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/link-map"
                     title="Карта зв'язків"
                     aria-label="Карта зв'язків">
                <i class="bi bi-bezier2"></i>
                <span class="visually-hidden">Карта зв'язків</span>
            </NavLink>
        }


        @if (ActiveSection == "group-hierarchy")
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/group-hierarchy"
                     Match="NavLinkMatch.All"
                     title="Ієрархія груп"
                     aria-label="Ієрархія груп">
                <i class="bi bi-diagram-3"></i>
                <span class="visually-hidden">Ієрархія груп</span>
            </NavLink>
        }
        else
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/group-hierarchy"
                     title="Ієрархія груп"
                     aria-label="Ієрархія груп">
                <i class="bi bi-diagram-3"></i>
                <span class="visually-hidden">Ієрархія груп</span>
            </NavLink>
        }
        @if (ActiveSection == "person-identities")
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/person-identities"
                     Match="NavLinkMatch.All"
                     title="Кандидати на об'єднання"
                     aria-label="Кандидати на об'єднання">
                <i class="bi bi-person-vcard"></i>
                <span class="visually-hidden">Кандидати на об'єднання</span>
            </NavLink>
        }
        else
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/person-identities"
                     title="Кандидати на об'єднання"
                     aria-label="Кандидати на об'єднання">
                <i class="bi bi-person-vcard"></i>
                <span class="visually-hidden">Кандидати на об'єднання</span>
            </NavLink>
        }
        @if (ActiveSection == "frequency-weights")
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/frequency-weights"
                     Match="NavLinkMatch.All"
                     title="Вага підрозділів"
                     aria-label="Вага підрозділів">
                <i class="bi bi-broadcast"></i>
                <span class="visually-hidden">Вага підрозділів</span>
            </NavLink>
        }
        else
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="/analytics/frequency-weights"
                     title="Вага підрозділів"
                     aria-label="Вага підрозділів">
                <i class="bi bi-broadcast"></i>
                <span class="visually-hidden">Вага підрозділів</span>
            </NavLink>
        }
    </div>

    <div class="registry-toolbar-meta toolbar-meta">
        @if (MetaContent is not null)
        {
            @MetaContent
        }
    </div>

    <div class="toolbar-actions d-flex align-items-center gap-2 justify-content-end flex-wrap">
        @if (ActionsContent is not null)
        {
            @ActionsContent
        }
    </div>
</div>
