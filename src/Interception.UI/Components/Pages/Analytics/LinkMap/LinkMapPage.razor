@page "/analytics/link-map"
@using Interception.UI.Application.Exports.Models
@using Interception.UI.Components.Pages.Analytics.LinkMap.Drawers
@using Interception.UI.Components.Pages.Analytics.Toolbar

<div class="page-shell linkmap-page-shell">
    <CandidatesToolbar ActiveSection="link-map">
        <MetaContent>
            <div class="toolbar-meta-grid">
                <div class="toolbar-field toolbar-field-date">
                    <label class="form-label small mb-1">Від</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="date"
                           value="@DateFromStr"
                           @onchange="@(e => OnDateFromChanged(e.Value?.ToString()))" />
                </div>

                <div class="toolbar-field toolbar-field-date">
                    <label class="form-label small mb-1">До</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="date"
                           value="@DateToStr"
                           @onchange="@(e => OnDateToChanged(e.Value?.ToString()))" />
                </div>

                <div class="toolbar-field toolbar-field-search">
                    <label class="form-label small mb-1">Пошук</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="text"
                           value="@_search"
                           @oninput="@(e => OnSearchChanged(e.Value?.ToString()))"
                           placeholder="Частота / особа / дія / підрозділ" />
                </div>

                <div class="toolbar-field toolbar-field-sort">
                    <label class="form-label small mb-1">Сорт.</label>
                    <select class="form-select form-select-sm rounded-0" @bind="_sort">
                        <option value="connections">За зв'язками</option>
                        <option value="action">За дією</option>
                        <option value="name">За назвою</option>
                    </select>
                </div>

                <label class="form-check form-switch toolbar-switch" for="strongOnly">
                    <input class="form-check-input" type="checkbox" id="strongOnly" @bind="_strongOnly" />
                    <span class="form-check-label small">+ зв'язком</span>
                </label>
            </div>
        </MetaContent>
        <ActionsContent>
            <div class="registry-toolbar-meta toolbar-inline-meta">
                Груп: <strong>@VisibleGroups.Count</strong>
            </div>
            <ExportLauncher Kind="ExportKind.LinkMap"
                            ButtonClass="btn btn-outline-secondary btn-sm rounded-0 icon-action-btn"
                            DateFrom="_dateFrom"
                            DateTo="_dateTo" />
            <button type="button"
                    class="btn btn-secondary btn-sm rounded-0 icon-action-btn"
                    @onclick="ResetPeriodAsync"
                    disabled="@(_loading || _rebuilding)"
                    title="Скинути період на 7 днів"
                    aria-label="Скинути період на 7 днів">
                <i class="bi bi-calendar-week"></i>
            </button>
            <button type="button"
                    class="btn btn-outline-primary btn-sm rounded-0 icon-action-btn"
                    @onclick="RebuildSnapshotAsync"
                    disabled="@(_loading || _rebuilding)"
                    title="Рефреш"
                    aria-label="Рефреш">
                @if (_rebuilding)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-hdd-stack"></i>
                }
            </button>
            <button type="button"
                    class="btn btn-primary btn-sm rounded-0 icon-action-btn"
                    @onclick="LoadAsync"
                    disabled="@(_loading || _rebuilding)"
                    title="Оновити карту"
                    aria-label="Оновити карту">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat"></i>
                }
            </button>
        </ActionsContent>
    </CandidatesToolbar>

    <div class="page-panel linkmap-shell">
        @if (_snapshotState?.HasSnapshot == true && _snapshotState.IsStale)
        {
            <div class="snapshot-banner alert alert-warning rounded-0 border-0 border-bottom mb-0 small d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div>Перехвати змінені після останньої перебудови карти. Зараз показано застарілий snapshot.</div>
                <button type="button"
                        class="btn btn-outline-dark btn-sm rounded-0"
                        @onclick="RebuildSnapshotAsync"
                        disabled="@(_loading || _rebuilding)">
                    @(_rebuilding ? "Перебудова..." : "Перебудувати")
                </button>
            </div>
        }
        else if (_snapshotState?.Status == "failed")
        {
            <div class="snapshot-banner alert alert-danger rounded-0 border-0 border-bottom mb-0 small d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div>
                    Остання перебудова карти завершилась помилкою.
                    @if (!string.IsNullOrWhiteSpace(_snapshotState.ErrorMessage))
                    {
                        <span> @_snapshotState.ErrorMessage</span>
                    }
                </div>
                <button type="button"
                        class="btn btn-outline-light btn-sm rounded-0"
                        @onclick="RebuildSnapshotAsync"
                        disabled="@(_loading || _rebuilding)">
                    @(_rebuilding ? "Повтор..." : "Повторити")
                </button>
            </div>
        }
        else if (_snapshotState is not null && !_snapshotState.HasSnapshot)
        {
            <div class="snapshot-banner alert alert-info rounded-0 border-0 border-bottom mb-0 small d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div>Для поточного періоду snapshot ще не побудований.</div>
                <button type="button"
                        class="btn btn-outline-primary btn-sm rounded-0"
                        @onclick="RebuildSnapshotAsync"
                        disabled="@(_loading || _rebuilding)">
                    @(_rebuilding ? "Побудова..." : "Побудувати")
                </button>
            </div>
        }

        @if (_loading)
        {
            <div class="p-3 text-muted small">Завантаження карти зв'язків…</div>
        }
        else if (_map is null || VisibleGroups.Count == 0)
        {
            <div class="p-3 page-empty small">@EmptyMessage</div>
        }
        else
        {
            <div class="row g-0 h-100 linkmap-layout">
                <div class="col-12 col-xl-6 border-end d-flex flex-column min-h-0 left-pane">
                    <div class="pane-head px-3 py-2 border-bottom small d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Групи</span>
                        <span class="text-muted">@VisibleGroups.Count</span>
                    </div>

                    <div class="panel-scroll px-2 py-2">
                        @foreach (var group in VisibleGroups)
                        {
                            var selected = _selectedGroup?.GroupKey == group.GroupKey;

                            <button type="button"
                                    class="linkmap-group-row @(selected ? "is-selected" : null)"
                                    @onclick="() => SelectGroup(group)">
                                <div class="group-row-line group-row-line-top">
                                    <span class="row-main-item"><i class="bi bi-broadcast-pin"></i>@PrimaryFrequency(group)</span>
                                    <span class="row-main-sep">/</span>
                                    <span class="row-main-item"><i class="bi bi-person"></i>@group.KeyPersonName</span>
                                    <span class="row-main-sep">/</span>
                                    <span class="row-main-item"><i class="bi bi-lightning-charge"></i>@FriendlyAction(group.PrimaryAction)</span>
                                </div>

                                <div class="group-row-line group-row-line-bottom">
                                    <span class="row-sub-item"><i class="bi bi-diagram-3"></i>@FriendlyDivision(group.Division)</span>
                                    <span class="row-sub-dot">•</span>
                                    <span class="row-sub-item"><i class="bi bi-signpost-2"></i>@group.Bridges.Count</span>
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm rounded-0 ms-auto"
                                            title="Деталі групи"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenGroupDrawer(group)">
                                        Деталі
                                    </button>
                                </div>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-12 col-xl-6 d-flex flex-column min-h-0 right-pane">
                    @if (_selectedGroup is null)
                    {
                        <div class="p-3 text-muted small">Оберіть групу зліва.</div>
                    }
                    else
                    {
                        <div class="pane-head px-3 py-2 border-bottom small d-flex justify-content-between align-items-center gap-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="fw-semibold">@PrimaryFrequency(_selectedGroup)</span>
                                <span class="text-muted">/</span>
                                <span>@_selectedGroup.KeyPersonName</span>
                                <span class="text-muted">/</span>
                                <span>@FriendlyAction(_selectedGroup.PrimaryAction)</span>
                            </div>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm rounded-0"
                                    @onclick="OpenSelectedGroupDrawer">
                                Деталі групи
                            </button>
                        </div>

                        <div class="panel-scroll px-3 py-3">
                            <div class="focus-summary-row small text-muted mb-3">
                                <span><i class="bi bi-diagram-3"></i>@FriendlyDivision(_selectedGroup.Division)</span>
                                <span>•</span>
                                <span><i class="bi bi-people"></i>@_selectedGroup.Members.Count</span>
                                <span>•</span>
                                <span><i class="bi bi-signpost-2"></i>@FocusedLinks.Count</span>
                            </div>

                            @if (FocusedLinks.Count == 0)
                            {
                                <div class="text-muted small">Для цієї групи не знайдено мостів.</div>
                            }
                            else
                            {
                                foreach (var item in FocusedLinks)
                                {
                                    var sharePercent = GetNormalizedSharePercent(item, FocusedLinks);
                                    <div class="bridge-row" @onclick="() => SelectGroup(item.TargetGroup)">
                                        <div class="bridge-row-main">
                                            <div class="bridge-row-title">
                                                <span class="bridge-title-item"><i class="bi bi-broadcast-pin"></i>@PrimaryFrequency(item.TargetGroup)</span>
                                                <span class="bridge-title-sep">/</span>
                                                <span class="bridge-title-item"><i class="bi bi-person"></i>@item.TargetGroup.KeyPersonName</span>
                                                <span class="bridge-title-sep">/</span>
                                                <span class="bridge-title-item"><i class="bi bi-arrow-left-right"></i>@FriendlyAction(item.Bridge.PrimaryAction)</span>
                                            </div>

                                            <div class="bridge-row-actions">
                                                <span class="bridge-share-value">@sharePercent.ToString("0.#")%</span>
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm rounded-0"
                                                        title="Деталі групи"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => OpenGroupDrawer(item.TargetGroup)">
                                                    Деталі
                                                </button>
                                            </div>
                                        </div>

                                        <div class="bridge-row-sub small text-muted">
                                            <span><i class="bi bi-diagram-3"></i>@FriendlyDivision(item.TargetGroup.Division)</span>
                                            <span>•</span>
                                            <span><i class="bi bi-person-badge"></i>@item.Bridge.ContactPersonName</span>
                                            <span>•</span>
                                            <span><i class="bi bi-broadcast"></i>@item.Bridge.BridgeFrequency</span>
                                        </div>

                                        <div class="bridge-bar-track" aria-hidden="true">
                                            <div class="bridge-bar-fill @GetBridgeBarClass(sharePercent)" style="width:@sharePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <LinkMapGroupDrawer IsOpen="@_drawerOpen"
                                Group="@_drawerGroup"
                                OnClose="CloseDrawerAsync" />
        }
    </div>
</div>
