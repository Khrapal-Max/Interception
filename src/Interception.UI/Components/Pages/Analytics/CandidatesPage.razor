@page "/analytics/candidates"
@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Components.Pages.Analytics.Drawers
@using Interception.UI.Domain.Enums
@namespace Interception.UI.Components.Pages.Analytics

<PageTitle>Кандидати на ідентифікацію</PageTitle>

<div class="d-flex flex-column h-100">

    <!-- Toolbar -->
    <div class="registry-toolbar flex-shrink-0">
        <div class="registry-toolbar-meta">
            @if (_pagedResult is not null)
            {
                <span>Всього: <strong>@_pagedResult.TotalCount</strong></span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="RunAnalysisAsync"
                    disabled="@(_running || _activeTab != CandidateGroupStatus.Open)">
                @if (_running)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-cpu me-1"></i>
                }
                Запустити аналіз
            </button>
        </div>
    </div>

    <!-- Таби -->
    <div class="flex-shrink-0 px-3 pt-2">
        <ul class="nav nav-tabs border-secondary">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == CandidateGroupStatus.Open ? "active" : "text-secondary")"
                        @onclick="() => SwitchTabAsync(CandidateGroupStatus.Open)">
                    Очікують
                    @if (_openCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@_openCount</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == CandidateGroupStatus.Confirmed ? "active" : "text-secondary")"
                        @onclick="() => SwitchTabAsync(CandidateGroupStatus.Confirmed)">
                    Підтверджені
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == CandidateGroupStatus.Dismissed ? "active" : "text-secondary")"
                        @onclick="() => SwitchTabAsync(CandidateGroupStatus.Dismissed)">
                    Відхилені
                </button>
            </li>
        </ul>
    </div>

    <!-- Таблиця -->
    <div class="flex-grow-1 overflow-auto">
        @if (_loading)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
            </div>
        }
        else if (_pagedResult is null || _pagedResult.TotalCount == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-question-mark fs-1 d-block mb-2 opacity-25"></i>
                @if (_activeTab == CandidateGroupStatus.Open)
                {
                    <div>Груп для розгляду немає</div>
                    <div class="small mt-1">Натисніть «Запустити аналіз» щоб знайти спільні ознаки серед НВ</div>
                }
                else
                {
                    <div>Записів немає</div>
                }
            </div>
        }
        else
        {
            <table class="table table-dark table-hover table-sm align-middle mb-0">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th class="fw-normal text-secondary small text-uppercase py-2">Впевненість</th>
                        <th class="fw-normal text-secondary small text-uppercase py-2">Пропозиція</th>
                        <th class="fw-normal text-secondary small text-uppercase py-2">Ознаки</th>
                        <th class="fw-normal text-secondary small text-uppercase py-2">Спост.</th>
                        @if (_activeTab != CandidateGroupStatus.Open)
                        {
                            <th class="fw-normal text-secondary small text-uppercase py-2">Оператор</th>
                        }
                        <th style="width:48px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _pagedResult.Items)
                    {
                        var group = g;
                        <tr class="border-bottom border-secondary border-opacity-25">
                            <td style="min-width:120px">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px">
                                        <div class="progress-bar @ConfidenceBarClass(group.ConfidenceScore)"
                                             style="@($"width:{group.ConfidenceScore * 100:F0}%")">
                                        </div>
                                    </div>
                                    <small class="text-muted text-nowrap">
                                        @($"{group.ConfidenceScore * 100:F0}")%
                                    </small>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(group.SuggestedName))
                                {
                                    <span class="fw-medium">@group.SuggestedName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(group.SuggestedDivision))
                                {
                                    <small class="text-muted d-block">@group.SuggestedDivision</small>
                                }
                                @if (string.IsNullOrWhiteSpace(group.SuggestedName) &&
                                     string.IsNullOrWhiteSpace(group.SuggestedDivision))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var reason in group.Reasons.ActiveReasons)
                                    {
                                        <span class="badge bg-secondary bg-opacity-50 small">
                                            @reason
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="small text-muted">@group.Refs.Count</td>
                            @if (_activeTab != CandidateGroupStatus.Open)
                            {
                                <td class="small text-muted text-nowrap">
                                    @group.ResolvedBy · @group.ResolvedAt?.ToString("dd.MM.yy")
                                </td>
                            }
                            <td class="text-end pe-2">
                                <button class="btn btn-sm btn-outline-light py-0 px-2"
                                        title="Переглянути"
                                        @onclick="() => OpenGroup(group)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_pagedResult.TotalPages > 1)
            {
                <nav class="d-flex justify-content-center py-2">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!_pagedResult.HasPreviousPage ? "disabled" : "")">
                            <button class="page-link"
                                    @onclick="() => GoToPageAsync(_currentPage - 1)">‹</button>
                        </li>
                        @for (var i = 1; i <= _pagedResult.TotalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(p == _currentPage ? "active" : "")">
                                <button class="page-link"
                                        @onclick="() => GoToPageAsync(p)">@p</button>
                            </li>
                        }
                        <li class="page-item @(!_pagedResult.HasNextPage ? "disabled" : "")">
                            <button class="page-link"
                                    @onclick="() => GoToPageAsync(_currentPage + 1)">›</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>

</div>

<CandidateGroupDrawer @bind-IsOpen="_drawerOpen"
                      Group="_selectedGroup"
                      OnConfirmed="OnGroupClosed"
                      OnDismissed="OnGroupClosed" />
