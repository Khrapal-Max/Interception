@page "/analytics/candidates"

<PageTitle>Черга аналізу</PageTitle>

<div class="container-fluid py-2 candidates-page">
    <div class="candidates-toolbar">
        <div class="card rounded-0 shadow-sm">
            <div class="card-body py-2">
                <div class="row g-2 justify-content-between align-items-center">
                    <div class="col-12 col-lg-10">                        
                        <input class="form-control form-control-sm rounded-0"
                               @bind="_query"
                               @bind:event="oninput"
                               placeholder="Кандидат, роль, дія, сигнал…" />
                    </div>

                    <div class="col-12 col-lg-2">
                        <button type="button"
                                class="btn btn-primary btn-sm rounded-0 flex-fill"
                                @onclick="SearchAsync"
                                disabled="@_loading">
                            Пошук
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm rounded-0"
                                @onclick="ResetAsync"
                                disabled="@_loading">
                            Скинути
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card rounded-0 shadow-sm candidates-content-card">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <span>Черга аналізу</span>
            <span class="small text-muted">Усього: @_page?.Total</span>
        </div>

        <div class="candidates-table-wrap">
            <div class="table-responsive h-100">
                <table class="table table-sm table-hover align-middle mb-0 candidates-table">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">Пріоритет</th>
                            <th class="text-center">Особа</th>
                            <th class="text-center">Роль</th>                       
                            <th class="text-center">Спостережень</th>
                            <th class="text-center">Топ-дії</th>                            
                            <th class="text-center">Дата up</th>
                            <th class="text-center">Сигнали</th>
                            <th class="text-center">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr>
                                <td colspan="9" class="text-muted p-4 text-center">Завантаження…</td>
                            </tr>
                        }
                        else if (_page is null || _page.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-muted p-4 text-center">Кандидатів не знайдено.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _page.Items)
                            {
                                <tr>
                                    <td class="text-nowrap text-center">
                                       
                                        <span class="badge rounded-2 @GetPriorityBadgeClass(item.PriorityBand)">
                                            @GetPriorityBandText(item.PriorityBand) @item.PriorityScore
                                        </span>
                                    </td>
                                    <td class="candidate-col text-center">
                                        <div class="fw-semibold">@item.DisplayName</div>
                                    </td>
                                    <td class="text-nowrap">@(item.PrimaryRole ?? "—")</td>                                                                

                                    <td class="text-center text-nowrap">@item.ObservationsCount</td>

                                    <td>
                                        @if (item.TopActions.Count == 0)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var action in item.TopActions)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@action</span>
                                                }
                                            </div>
                                        }
                                    </td>                                   

                                    <td class="text-nowrap text-center">@(item.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")</td>

                                    <td>
                                        @if (item.TopSignals.Count == 0)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                                @foreach (var signal in item.TopSignals)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@signal</span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-primary rounded-0"
                                                   href="@($"/analytics/candidates/{item.CandidateKey}")">
                                                Деталі
                                            </a>

                                            @if (item.ClusterId is not null)
                                            {
                                                <a class="btn btn-warning rounded-0"
                                                       href="@($"/analytics/clusters/{item.ClusterId}")">
                                                    Припущення
                                                </a>
                                            }
                                            else if (item.ParticipantId is not null)
                                            {
                                                <a class="btn btn-success rounded-0"
                                                       href="@($"/analytics/participants/{item.ParticipantId}")">
                                                    Аналіз
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer py-2 d-flex justify-content-between align-items-center candidates-footer">
            <div class="small text-muted">@($"{_pageIndex + 1} / {TotalPages}")</div>

            <div class="btn-group btn-group-sm">
                <button class="btn btn-secondary rounded-0"
                        @onclick="PrevPageAsync"
                        disabled="@(!CanPrev || _loading)">
                    Назад
                </button>

                <button class="btn btn-secondary rounded-0"
                        @onclick="NextPageAsync"
                        disabled="@(!CanNext || _loading)">
                    Вперед
                </button>
            </div>
        </div>
    </div>
</div>