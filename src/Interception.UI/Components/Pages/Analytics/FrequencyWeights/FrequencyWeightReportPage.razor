@page "/analytics/frequency-weights"
@using Interception.UI.Application.Exports.Models
@using Interception.UI.Components.Pages.Analytics.Toolbar

<PageTitle>Аналітика — Вага підрозділів по частотах</PageTitle>

<div class="page-shell freq-page-shell">

    <CandidatesToolbar ActiveSection="frequency-weights">
        <MetaContent>
            Частот: <strong>@(_report?.Frequencies.Count ?? 0)</strong>
        </MetaContent>
        <ActionsContent>

            <ExportLauncher Kind="ExportKind.FrequencyWeights"
                            Title=".xlsx"
                            ButtonClass="btn btn-outline-secondary btn-sm rounded-0" />

            <button class="btn btn-success btn-sm"
                    @onclick="LoadAsync"
                    disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-1"></i>
                }
                Оновити
            </button>
        </ActionsContent>
    </CandidatesToolbar>

    <div class="page-panel freq-page-panel">
        @if (_loading)
        {
            <div class="freq-panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_report is null || _report.Frequencies.Count == 0)
        {
            <div class="freq-panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-broadcast fs-1 d-block mb-2 opacity-25"></i>
                    <div>Даних по частотах не знайдено</div>
                </div>
            </div>
        }
        else
        {
            <div class="freq-panel-scroll p-0">
                <div class="freq-table-scroll">
                    <table class="table table-sm align-middle data-table freq-table">
                        <thead>
                            <tr>
                                <th>Частота</th>
                                <th>Підрозділ по частоті</th>
                                <th>Група підрозділу</th>
                                <th class="text-end">Кількість учасників</th>
                                <th class="text-end">Вага, %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var frequencyIndex = 0; frequencyIndex < _report.Frequencies.Count; frequencyIndex++)
                            {
                                var frequency = _report.Frequencies[frequencyIndex];

                                if (frequency.Groups.Count == 0)
                                {
                                    <tr class="freq-single">
                                        <td class="freq-frequency">@frequency.Frequency</td>
                                        <td class="freq-division">@(frequency.FrequencyDivision ?? "—")</td>
                                        <td class="freq-empty">Невідомо</td>
                                        <td class="text-end">0</td>
                                        <td class="text-end text-nowrap">0</td>
                                    </tr>
                                }
                                else
                                {
                                    for (var groupIndex = 0; groupIndex < frequency.Groups.Count; groupIndex++)
                                    {
                                        var group = frequency.Groups[groupIndex];
                                        var isFirstRow = groupIndex == 0;
                                        var isLastRow = groupIndex == frequency.Groups.Count - 1;

                                        var rowClass = isFirstRow && isLastRow
                                            ? "freq-single"
                                            : isFirstRow
                                                ? "freq-start"
                                                : isLastRow
                                                    ? "freq-end"
                                                    : "freq-middle";

                                        <tr class="@rowClass">
                                            <td class="freq-frequency">@(isFirstRow ? frequency.Frequency : string.Empty)</td>
                                            <td class="freq-division">@(isFirstRow ? frequency.FrequencyDivision ?? "—" : string.Empty)</td>
                                            <td class="freq-group-name">@group.GroupName</td>
                                            <td class="text-end">@group.PersonsCount</td>
                                            <td class="text-end text-nowrap">@group.WeightPercent.ToString("0.##")</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

</div>
