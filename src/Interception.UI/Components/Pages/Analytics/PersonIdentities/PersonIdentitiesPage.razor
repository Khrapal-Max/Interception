@page "/analytics/person-identities"
@using Interception.UI.Components.Pages.Analytics.Toolbar
@using Interception.UI.Extensions

<PageTitle>Аналітика — Кандидати на об’єднання</PageTitle>

<div class="page-shell identities-page-shell">
    <CandidatesToolbar ActiveSection="person-identities">
        <MetaContent>
            @if (_candidates is not null)
            {
                <span>Кандидати: <strong>@TotalCandidates</strong></span>
                <span>Уже мають об’єднаний профіль: <strong>@ReadyCanonicalCount</strong></span>
            }
        </MetaContent>
        <ActionsContent>
            <button type="button" class="btn btn-success btn-sm rounded-0" @onclick="LoadAsync" disabled="@_loading" aria-label="Оновити">
                <i class="bi bi-arrow-repeat me-1"></i>Оновити
            </button>
        </ActionsContent>
    </CandidatesToolbar>

    <div class="page-panel h-100 identities-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Пошук кандидатів…
                </div>
            </div>
        }
        else if (_candidates is null || _candidates.Count == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-person-vcard fs-1 d-block mb-2 opacity-25"></i>
                    <div>Кандидатів на об'єднання не знайдено</div>
                    <div class="small mt-1">Сторінка показує лише проблемні випадки — дублікати або однакові імена в кількох контекстах.</div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-0 h-100 identities-layout">
                <div class="col-12 col-xxl-4 border-end d-flex flex-column min-h-0 identities-left-pane">
                    <div class="pane-head px-3 py-3 border-bottom flex-shrink-0">
                        <h5 class="mb-1">Кандидати на об’єднання</h5>
                        <div class="small text-muted">Не всі особи системи, а лише випадки, де є сенс у злитті.</div>
                    </div>

                    <div class="panel-scroll identities-left-scroll px-2 py-2">
                        @foreach (var candidate in _candidates)
                        {
                            var isSelected = _selected?.CandidateKey == candidate.CandidateKey;
                            <button type="button"
                                    class="cluster-row @(isSelected ? "is-selected" : null)"
                                    @onclick="() => SelectCandidateAsync(candidate)">
                                <div class="cluster-row-top">
                                    <div>
                                        <div class="cluster-title">@candidate.DisplayName</div>
                                        <div class="small text-muted">Підтверджених рядків: @candidate.ConfirmedRowsCount</div>
                                    </div>
                                    @if (candidate.HasCanonicalPerson)
                                    {
                                        <span class="badge text-bg-success">Є профіль</span>
                                    }
                                </div>
                                <div class="cluster-row-meta small text-muted">
                                    <span><i class="bi bi-broadcast me-1"></i>@candidate.DistinctFrequencyCount частот</span>
                                    <span>•</span>
                                    <span><i class="bi bi-diagram-3 me-1"></i>@candidate.DistinctDivisionCount підрозділів</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-12 col-xxl-8 d-flex flex-column min-h-0 identities-right-pane">
                    @if (_selected is null)
                    {
                        <div class="p-3 text-muted small">Оберіть кандидата зліва.</div>
                    }
                    else
                    {
                        <div class="pane-head px-3 py-3 border-bottom d-flex justify-content-between align-items-center gap-3 flex-wrap flex-shrink-0">
                            <div>
                                <h4 class="mb-1">@_selected.DisplayName</h4>
                                <div class="small text-muted">Аналітичний крок для злиття кількох підтверджених записів в одну особу.</div>
                            </div>
                            @if (_selected.HasSingleProfile)
                            {
                                <span class="badge text-bg-success">Є об’єднаний профіль</span>
                            }
                            else if (_selected.HasMultipleProfiles)
                            {
                                <span class="badge text-bg-warning">Є кілька окремих профілів</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ще без профілю</span>
                            }
                        </div>

                        <div class="panel-scroll identities-right-scroll px-3 py-3">
                            @if (!string.IsNullOrWhiteSpace(_selected.Warning))
                            {
                                <div class="alert alert-warning rounded-0">@_selected.Warning</div>
                            }

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-lg-6">
                                    <div class="border rounded-0 p-3 h-100">
                                        <div class="fw-semibold mb-2">Контексти зі спостережень</div>
                                        <div class="small text-muted mb-2">Це підказка для аналітика, а не автоматичне злиття.</div>
                                        <div class="small mb-2"><strong>Частоти:</strong></div>
                                        @if (_selected.Frequencies.Count == 0)
                                        {
                                            <div class="small text-muted mb-2">—</div>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled small mb-2">
                                                @foreach (var frequency in _selected.Frequencies)
                                                {
                                                    <li class="mb-1"><span class="badge text-bg-dark-subtle border">@frequency</span></li>
                                                }
                                            </ul>
                                        }

                                        <div class="small mb-2"><strong>Підрозділи:</strong></div>
                                        @if (_selected.Divisions.Count == 0)
                                        {
                                            <div class="small text-muted">—</div>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled small mb-0">
                                                @foreach (var division in _selected.Divisions)
                                                {
                                                    <li class="mb-1">@division</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="border rounded-0 p-3 h-100">
                                        <div class="fw-semibold mb-2">Об’єднаний профіль</div>
                                        @if (_selected.HasSingleProfile)
                                        {
                                            <div class="small mb-1"><strong>Назва:</strong> @_selected.CanonicalDisplayName</div>
                                            <div class="small"><strong>Нотатка:</strong> @(string.IsNullOrWhiteSpace(_selected.CanonicalNote) ? "—" : _selected.CanonicalNote)</div>
                                        }
                                        else if (_selected.HasMultipleProfiles)
                                        {
                                            <div class="small text-muted">Для цього кандидата вже існує кілька окремих профілів. Оператор може звести їх в один профіль.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">Ще не створений. Нижче можна вибрати підтверджені рядки і створити об’єднаний профіль лише для цього проблемного кейсу.</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-0 p-3 mb-3">
                                <div class="fw-semibold mb-2">Підтверджені рядки для об’єднання</div>
                                <div class="small text-muted mb-3">Для поодиноких осіб нічого робити не потрібно. Тут працюємо лише з тими випадками, де є сенс у злитті.</div>

                                <div class="table-wrap identities-table-wrap">
                                    <table class="table table-hover table-sm align-middle data-table mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 6%"></th>
                                                <th style="width: 20%">Позивний</th>
                                                <th style="width: 14%">Частота</th>
                                                <th style="width: 18%">Роль</th>
                                                <th style="width: 26%">Підрозділ</th>
                                                <th style="width: 8%">Obs</th>
                                                <th style="width: 8%">Статус</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in _selected.Rows)
                                            {
                                                var disableRow = _saving || (_selected.HasSingleProfile && row.IsLinkedToCanonical);
                                                <tr>
                                                    <td>
                                                        <input type="checkbox"
                                                               class="form-check-input"
                                                               checked="@IsChecked(row.ResolvedParticipantId)"
                                                               disabled="@disableRow"
                                                               @onchange="@(e => ToggleRow(row.ResolvedParticipantId, e.Value is bool b && b))" />
                                                    </td>
                                                    <td class="fw-medium">@row.Name</td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(row.Frequency) ? "—" : row.Frequency)</td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(row.Role) ? "—" : row.Role)</td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(row.Division) ? "—" : row.Division)</td>
                                                    <td class="small text-muted">@row.ObservationCount</td>
                                                    <td>
                                                        @if (row.IsLinkedToCanonical)
                                                        {
                                                            <span class="badge text-bg-success">У профілі</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge text-bg-secondary">Доступний</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="identity-actions border-top px-3 py-3">
                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <label class="form-label">Назва профілю</label>
                                    <input class="form-control rounded-0"
                                           @bind="_displayName"
                                           placeholder="Наприклад: СЛОНИК" />
                                </div>

                                <div>
                                    <label class="form-label">Примітка аналітика</label>
                                    <textarea class="form-control rounded-0"
                                              rows="3"
                                              @bind="_note"
                                              placeholder="Коротко: чому ці рядки належать одній людині"></textarea>
                                </div>

                                <div class="d-flex justify-content-end gap-2 flex-wrap">
                                    @if (_selected.HasSingleProfile)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-light btn-sm rounded-0"
                                                @onclick="UpdateAsync"
                                                disabled="@_saving">
                                            <i class="bi bi-pencil-square me-1"></i>Редагувати
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm rounded-0"
                                                @onclick="DeleteAsync"
                                                disabled="@_saving">
                                            <i class="bi bi-trash me-1"></i>Видалити
                                        </button>
                                    }

                                    <button type="button"
                                            class="btn btn-success btn-sm rounded-0"
                                            @onclick="SaveAsync"
                                            disabled="@(_saving || _selectedRows.Count == 0)">
                                        @if (_saving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-check me-1"></i>
                                        }
                                        @(_selected.HasSingleProfile ? "Додати в профіль" : _selected.HasMultipleProfiles ? "Звести в один профіль" : "Об’єднати в один профіль")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
