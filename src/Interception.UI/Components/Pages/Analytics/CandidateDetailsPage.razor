@page "/analytics/candidates/{CandidateKey}"

<PageTitle>Деталізація кандидата</PageTitle>

<div class="container-fluid py-2 d-flex flex-column gap-2">
    @if (_loading)
    {
        <div class="card rounded-0">
            <div class="card-body text-center text-muted py-5">Завантаження…</div>
        </div>
    }
    else if (_dto is null)
    {
        <div class="alert alert-warning rounded-0 mb-0">Кандидата не знайдено.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold">Деталізація кандидата</div>
                <div class="small text-muted">@_dto.CandidateKey</div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm rounded-0" href="/analytics/candidates">До черги</a>

                @if (_dto.ClusterId is not null)
                {
                    <a class="btn btn-outline-primary btn-sm rounded-0"
                           href="@($"/analytics/clusters/{_dto.ClusterId}")">
                        Гіпотеза
                    </a>
                    <a class="btn btn-primary btn-sm rounded-0"
                           href="@($"/analytics/clusters/{_dto.ClusterId}/context")">
                        Контекст
                    </a>
                }
                else if (_dto.ParticipantId is not null)
                {
                    <a class="btn btn-primary btn-sm rounded-0"
                           href="@($"/analytics/participants/{_dto.ParticipantId}")">
                        Аналітика учасника
                    </a>
                }
            </div>
        </div>

        <div class="row g-2">
            <div class="col-12 col-xxl-7 d-flex flex-column gap-2">
                <div class="card rounded-0">
                    <div class="card-body py-2">
                        <div class="row g-2 small">
                            <div class="col-12 col-md-4">
                                <div class="text-muted">Кандидат</div>
                                <div class="fw-semibold">@_dto.DisplayName</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="text-muted">Тип</div>
                                <div>@GetCandidateTypeText(_dto.CandidateType)</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <div class="text-muted">Priority</div>
                                <div>
                                    @_dto.PriorityScore
                                    <span class="badge rounded-0 @GetPriorityBadgeClass(_dto.PriorityBand)">
                                        @GetPriorityBandText(_dto.PriorityBand)
                                    </span>
                                </div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="text-muted">Остання поява</div>
                                <div>@(_dto.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="text-muted">Observation</div>
                                <div>@_dto.ObservationsCount</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="text-muted">Різних дій</div>
                                <div>@_dto.DistinctActionsCount</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="text-muted">Роль</div>
                                <div>@(_dto.PrimaryRole ?? "—")</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="text-muted">Гіпотеза</div>
                                <div>@(_dto.ClusterCode ?? "—")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Observation кандидата</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Дата</th>
                                        <th>Дія</th>
                                        <th>Шар / РМ</th>
                                        <th>Локація</th>
                                        <th>Матч</th>
                                        <th class="text-end">Перехід</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _dto.Observations)
                                    {
                                        <tr>
                                            <td class="text-nowrap">
                                                <div>@item.ObservedDate.ToString("dd.MM.yyyy")</div>
                                                <div class="small text-muted">@(item.DayPart == 2 ? "PM" : "AM")</div>
                                            </td>
                                            <td>
                                                <div>@item.ActionRaw</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                                {
                                                    <div class="small text-muted">@item.Note</div>
                                                }
                                            </td>
                                            <td>
                                                <div>@(item.Layer ?? "—")</div>
                                                <div class="small text-muted">@(item.RmRaw ?? "—")</div>
                                            </td>
                                            <td>
                                                <div>@(item.LocationRaw ?? "—")</div>
                                                <div class="small text-muted">@(item.DistrictRaw ?? "—")</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@item.MatchScore</div>
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    @foreach (var signal in item.MatchedSignals)
                                                    {
                                                        <span class="badge text-bg-light border rounded-0">@signal</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-secondary rounded-0"
                                                       href="/observations">
                                                    Реєстр
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xxl-5 d-flex flex-column gap-2">
                <div class="card rounded-0">
                    <div class="card-header py-2">Сигнали</div>
                    <div class="card-body py-2">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var signal in _dto.Signals)
                            {
                                <div class="border rounded-0 p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="fw-semibold">@signal.Name</div>
                                        <span class="badge text-bg-light border rounded-0">@signal.Weight</span>
                                    </div>
                                    <div class="small text-muted mt-1">@signal.Explanation</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Пов’язані вузли</div>
                    <div class="card-body py-2">
                        @if (_dto.RelatedNodes.Count == 0)
                        {
                            <div class="text-muted small">Пов’язаних вузлів не знайдено.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush rounded-0">
                                @foreach (var node in _dto.RelatedNodes)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">@node.DisplayName</div>
                                                <div class="small text-muted">@node.NodeType · остання поява: @(node.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                                            </div>
                                            <span class="badge text-bg-light border rounded-0">@node.SeenCount</span>
                                        </div>

                                        @if (node.TopActions.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var action in node.TopActions)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@action</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Рекомендовані дії</div>
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var action in _dto.RecommendedActions)
                            {
                                <span class="badge text-bg-light border rounded-0">@action</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>