@page "/analytics/link-map-slices"
@using Interception.UI.Components.Pages.Analytics.Toolbar

<div class="page-shell">
    <CandidatesToolbar ActiveSection="link-map-slices">
        <MetaContent>
            <div class="d-flex flex-nowrap align-items-end gap-2">
                <div>
                    <label class="form-label small mb-1">Від</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="date"
                           value="@DateFromStr"
                           @onchange="@(e => OnDateFromChanged(e.Value?.ToString()))" />
                </div>

                <div>
                    <label class="form-label small mb-1">До</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="date"
                           value="@DateToStr"
                           @onchange="@(e => OnDateToChanged(e.Value?.ToString()))" />
                </div>

                <div>
                    <label class="form-label small mb-1">Пошук</label>
                    <input class="form-control form-control-sm rounded-0"
                           type="text"
                           value="@_search"
                           @oninput="@(e => OnSearchChanged(e.Value?.ToString()))"
                           placeholder="Ключова особа / учасник / дія" />
                </div>

                <div class="form-check form-switch mb-1 ms-1">
                    <input class="form-check-input" type="checkbox" id="missingOnly" @bind="_missingOnly" />
                    <label class="form-check-label small" for="missingOnly">Лише неповні</label>
                </div>
            </div>
        </MetaContent>
        <ActionsContent>
            <div class="registry-toolbar-meta">Зрізів: <strong>@VisibleGroups.Count</strong></div>
            <button type="button" class="btn btn-secondary btn-sm rounded-0" @onclick="ResetPeriodAsync" disabled="@_loading">7 днів</button>
            <button type="button" class="btn btn-primary btn-sm rounded-0" @onclick="LoadAsync" disabled="@_loading">Оновити</button>
        </ActionsContent>
    </CandidatesToolbar>

    <div class="page-panel p-0">
        @if (_loading)
        {
            <div class="p-3 text-muted small">Завантаження зрізу…</div>
        }
        else if (_slice is null || VisibleGroups.Count == 0)
        {
            <div class="p-3 page-empty small">Дані зрізу не знайдено.</div>
        }
        else
        {
            <div class="table-wrap p-0 border-0 rounded-0">
                <table class="table data-table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Центральна особа</th>
                            <th>Підрозділ</th>
                            <th>Учасники</th>
                            <th>Пропуски ролей</th>
                            <th>Спільні частоти</th>
                            <th>Спільна група дій</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in VisibleGroups)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@group.KeyPersonName</div>
                                    <div class="small text-muted">@string.Join(", ", group.Members.Take(3))</div>
                                </td>
                                <td class="small">
                                    @if (group.IsDivisionMissing)
                                    {
                                        <span class="badge rounded-0 text-bg-warning">НВ підрозділ</span>
                                    }
                                    else
                                    {
                                        <span>@group.Division</span>
                                    }
                                </td>
                                <td class="small">@group.MembersCount</td>
                                <td class="small">@group.MissingRoleCount</td>
                                <td class="small">@string.Join(", ", group.SharedFrequencies.Take(3))</td>
                                <td class="small">@string.Join(", ", group.SharedActions.Take(3))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
