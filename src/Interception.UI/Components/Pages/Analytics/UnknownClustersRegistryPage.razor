@page "/analytics/clusters"

<PageTitle>Припущення</PageTitle>

<div class="card shadow-sm rounded-0">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <strong>Припущення (кластери) щодо невизначених осіб</strong>
            <div class="small text-muted">Реєстр аналітичних кластерів із прив'язаними учасниками.</div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <input class="form-control form-control-sm rounded-0"
                   style="width: 16rem;"
                   @bind="_query"
                   @bind:event="oninput"
                   placeholder="Код, назва або встановлена особа" />

            <select class="form-select form-select-sm rounded-0" style="width: 12rem;" @bind="_status">
                <option value="">Усі статуси</option>
                <option value="open">Відкритий</option>
                <option value="resolved">Резолвлений</option>
                <option value="merged">Об'єднаний</option>
                <option value="archived">Архівний</option>
            </select>

            <button type="button" class="btn btn-sm btn-primary rounded-0" @onclick="SearchAsync" disabled="@_loading">
                Пошук
            </button>
            <button type="button" class="btn btn-sm btn-secondary rounded-0" @onclick="ResetAsync" disabled="@_loading">
                Скинути
            </button>
           
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Код</th>
                        <th>Назва</th>
                        <th class="text-center">Статус</th>
                        <th class="text-center">Учасників</th>
                        <th class="text-center">Остання поява</th>
                        <th class="text-center">Встановлена особа</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="7" class="text-muted">Завантаження…</td>
                        </tr>
                    }
                    else if (_page is null || _page.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-muted">Кластери не знайдено.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _page.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-nowrap">
                                    <a class="link-secondary text-decoration-none"
                                       href="@($"/analytics/clusters/{item.Id}")">
                                        @item.Code
                                    </a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.DisplayName) ? "—" : item.DisplayName)</td>
                                <td class="text-center">
                                    <span class="badge rounded-1 @GetStatusBadgeClass(item.Status)">@GetStatusText(item.Status)</span>
                                </td>
                                <td class="text-center">@item.ParticipantsCount</td>
                                <td class="text-nowrap text-center">@(item.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="text-center">@(string.IsNullOrWhiteSpace(item.LinkedActorDisplayName) ? "—" : item.LinkedActorDisplayName)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary rounded-0"
                                       href="@($"/analytics/clusters/{item.Id}")">
                                        Деталі
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
            <div class="text-muted small">Усього: @_page?.Total</div>

            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary rounded-0" @onclick="PrevPageAsync" disabled="@(!CanPrev || _loading)">Назад</button>
                <button type="button" class="btn btn-outline-secondary rounded-0" disabled>@($"{_pageIndex + 1} / {TotalPages}")</button>
                <button type="button" class="btn btn-outline-secondary rounded-0" @onclick="NextPageAsync" disabled="@(!CanNext || _loading)">Вперед</button>
            </div>
        </div>
    </div>
</div>
