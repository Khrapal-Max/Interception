@page "/analytics/clusters/{ClusterId:guid}/context"

<PageTitle>Контекст гіпотези</PageTitle>

<div class="container-fluid py-2 d-flex flex-column gap-2">
    @if (_loading)
    {
        <div class="card rounded-0">
            <div class="card-body text-center text-muted py-5">Завантаження…</div>
        </div>
    }
    else if (_dto is null)
    {
        <div class="alert alert-warning rounded-0 mb-0">Контекст не знайдено.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold">Контекст гіпотези</div>
                <div class="small text-muted">@_dto.Code · @(_dto.DisplayName ?? "—")</div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm rounded-0"
                       href="@($"/analytics/clusters/{_dto.ClusterId}")">
                    До гіпотези
                </a>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-12 col-xxl-7 d-flex flex-column gap-2">
                <div class="card rounded-0">
                    <div class="card-body py-2">
                        <div class="row g-2 small">
                            <div class="col-12 col-md-4">
                                <div class="text-muted">Код</div>
                                <div class="fw-semibold">@_dto.Code</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted">Назва</div>
                                <div>@(_dto.DisplayName ?? "—")</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <div class="text-muted">Direct</div>
                                <div>@_dto.DirectObservationsCount</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <div class="text-muted">Indirect</div>
                                <div>@_dto.IndirectObservationsCount</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Прямі observation</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Дата</th>
                                        <th>Дія</th>
                                        <th>Шар / РМ</th>
                                        <th>Локація</th>
                                        <th>Сигнали</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _dto.DirectObservations)
                                    {
                                        <tr>
                                            <td class="text-nowrap">
                                                <div>@item.ObservedDate.ToString("dd.MM.yyyy")</div>
                                                <div class="small text-muted">@(item.DayPart == 2 ? "PM" : "AM")</div>
                                            </td>
                                            <td>
                                                <div>@item.ActionRaw</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                                {
                                                    <div class="small text-muted">@item.Note</div>
                                                }
                                            </td>
                                            <td>
                                                <div>@(item.Layer ?? "—")</div>
                                                <div class="small text-muted">@(item.RmRaw ?? "—")</div>
                                            </td>
                                            <td>
                                                <div>@(item.LocationRaw ?? "—")</div>
                                                <div class="small text-muted">@(item.DistrictRaw ?? "—")</div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var signal in item.MatchedSignals)
                                                    {
                                                        <span class="badge text-bg-light border rounded-0">@signal</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Непрямі observation</div>
                    <div class="card-body p-0">
                        @if (_dto.IndirectObservations.Count == 0)
                        {
                            <div class="p-3 text-muted small">Непрямих зв’язків не знайдено.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Дата</th>
                                            <th>Дія</th>
                                            <th>Шар / РМ</th>
                                            <th>Локація</th>
                                            <th>Relation</th>
                                            <th>Score</th>
                                            <th>Сигнали</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _dto.IndirectObservations)
                                        {
                                            <tr>
                                                <td class="text-nowrap">
                                                    <div>@item.ObservedDate.ToString("dd.MM.yyyy")</div>
                                                    <div class="small text-muted">@(item.DayPart == 2 ? "PM" : "AM")</div>
                                                </td>
                                                <td>
                                                    <div>@item.ActionRaw</div>
                                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                                    {
                                                        <div class="small text-muted">@item.Note</div>
                                                    }
                                                </td>
                                                <td>
                                                    <div>@(item.Layer ?? "—")</div>
                                                    <div class="small text-muted">@(item.RmRaw ?? "—")</div>
                                                </td>
                                                <td>
                                                    <div>@(item.LocationRaw ?? "—")</div>
                                                    <div class="small text-muted">@(item.DistrictRaw ?? "—")</div>
                                                </td>
                                                <td>
                                                    <span class="badge rounded-0 @GetRelationBadgeClass(item.RelationKind)">
                                                        @item.RelationKind
                                                    </span>
                                                </td>
                                                <td>@item.Score</td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var signal in item.MatchedSignals)
                                                        {
                                                            <span class="badge text-bg-light border rounded-0">@signal</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xxl-5 d-flex flex-column gap-2">
                <div class="card rounded-0">
                    <div class="card-header py-2">Пов’язані вузли</div>
                    <div class="card-body py-2">
                        @if (_dto.RelatedNodes.Count == 0)
                        {
                            <div class="text-muted small">Пов’язаних вузлів не знайдено.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush rounded-0">
                                @foreach (var node in _dto.RelatedNodes)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">@node.DisplayName</div>
                                                <div class="small text-muted">@node.NodeType · остання поява: @(node.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                                            </div>

                                            <div class="text-end">
                                                <div class="fw-semibold">@node.PriorityScore</div>
                                                <div class="small text-muted">@node.SeenCount</div>
                                            </div>
                                        </div>

                                        @if (node.TopActions.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var action in node.TopActions)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@action</span>
                                                }
                                            </div>
                                        }

                                        @if (node.StrongSignals.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var signal in node.StrongSignals)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@signal</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card rounded-0">
                    <div class="card-header py-2">Ланцюжки по діях</div>
                    <div class="card-body py-2">
                        @if (_dto.ActionChains.Count == 0)
                        {
                            <div class="text-muted small">Ланцюжки не знайдено.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var chain in _dto.ActionChains)
                                {
                                    <div class="border rounded-0 p-2">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="fw-semibold">@chain.ActionRaw</div>
                                            <span class="badge text-bg-light border rounded-0">@chain.SeenCount</span>
                                        </div>

                                        @if (chain.Nodes.Count > 0)
                                        {
                                            <div class="small text-muted mt-1">
                                                @string.Join(", ", chain.Nodes)
                                            </div>
                                        }

                                        @if (chain.Signals.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var signal in chain.Signals)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@signal</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>