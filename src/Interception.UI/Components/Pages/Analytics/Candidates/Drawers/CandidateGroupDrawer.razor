@using Interception.UI.Application.Analytics.Dtos
@using Interception.UI.Extensions

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="@DrawerTitle"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        @if (Group is null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm"></div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-1">

                <!-- Статус Confirmed/Dismissed -->
                @if (Group.Status != CandidateGroupStatusDto.Open)
                {
                    <div class="alert @(Group.Status == CandidateGroupStatusDto.Confirmed
                        ? "alert-success" : "alert-secondary") py-2 px-3 small mb-0">
                        @if (Group.Status == CandidateGroupStatusDto.Confirmed)
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <strong>Підтверджено</strong> 
                            <span>як «@Group.SuggestedName»</span>
                        }
                        else
                        {
                            <i class="bi bi-x-circle me-1"></i>
                            <strong>Відхилено</strong>
                        }
                        @if (Group.ResolvedBy is not null)
                        {
                            <span class="text-muted ms-1">
                                — @Group.ResolvedBy · @(Group.ResolvedAt is null ? "—" : ConverterDateTimeExtensions.ToDisplay(Group.ResolvedAt.Value).ToString("dd.MM.yy HH:mm"))
                            </span>
                        }
                        @if (Group.Status == CandidateGroupStatusDto.Confirmed)
                        {
                            <div class="mt-2">
                                <a class="btn btn-outline-success btn-sm"
                                   href="/registries/persons">
                                    <i class="bi bi-people me-1"></i>Реєстр осіб
                                </a>
                            </div>
                        }
                    </div>
                }

                <!-- Ознаки збігу -->
                <div>
                    <div class="form-label form-label-sm text-muted">Ознаки збігу</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var reason in Group.Reasons.ActiveReasons)
                        {
                            <span class="badge bg-primary bg-opacity-75">@reason</span>
                        }
                        @if (!Group.Reasons.ActiveReasons.Any())
                        {
                            <span class="text-muted small">—</span>
                        }
                    </div>
                </div>

                <!-- Підказки з відомих учасників -->
                @if (_loadingSuggestions)
                {
                    <div class="text-muted small">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Аналіз відомих учасників...
                    </div>
                }
                else if (_suggestions.Count > 0)
                {
                    <div>
                        <div class="form-label form-label-sm text-muted mb-1">
                            Схожі відомі учасники
                        </div>
                        @foreach (var s in _suggestions)
                        {
                            <div class="border border-secondary rounded p-2 mb-2"
                                 style="cursor:pointer"
                                 @onclick="() => ApplySuggestion(s)">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-medium">@s.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(s.Role))
                                    {
                                        <small class="text-muted">@s.Role</small>
                                    }
                                    <div class="ms-auto d-flex align-items-center gap-1">
                                        <div class="progress" style="width:60px;height:5px">
                                            <div class="progress-bar @ScoreClass(s.MatchScore)"
                                                 style="@($"width:{s.MatchScore * 100:F0}%")">
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            @($"{s.MatchScore * 100:F0}")%
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-3 small mb-1">
                                    <span class="text-muted">частота @(s.Reasons.SameFrequency ? "✓" : "—")</span>
                                    <span class="text-muted">вектор @(s.Reasons.SameVector ? "✓" : "—")</span>
                                    <span class="text-muted">підрозділ @(s.Reasons.SameDivision ? "✓" : "—")</span>
                                    <span class="text-muted">роль @(s.Reasons.SameRole ? "✓" : "—")</span>
                                    @if (s.Reasons.PivotIntersection)
                                    {
                                        <span class="text-success">перехрестя ✓</span>
                                    }
                                </div>
                                @if (s.CommonLabels.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                        @foreach (var label in s.CommonLabels)
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info"
                                                  style="font-size:.7rem">@label</span>
                                        }
                                    </div>
                                }
                                @if (s.SeenCount > 1)
                                {
                                    <small class="text-muted d-block">
                                        зустрічався @s.SeenCount разів
                                    </small>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Ймовірна належність / контекст -->
                @if (!_loadingSuggestions && _contextSuggestions.Count > 0)
                {
                    <div>
                        <div class="form-label form-label-sm text-muted mb-1">
                            Ймовірна належність / контекст
                        </div>
                        @foreach (var s in _contextSuggestions)
                        {
                            <div class="border border-secondary rounded p-2 mb-2"
                                 style="cursor:pointer"
                                 @onclick="() => ApplyContextSuggestion(s)">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-medium">@s.Division</span>
                                    <div class="ms-auto d-flex align-items-center gap-1">
                                        <div class="progress" style="width:60px;height:5px">
                                            <div class="progress-bar @ScoreClass(s.MatchScore)"
                                                 style="@($"width:{s.MatchScore * 100:F0}%")">
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            @($"{s.MatchScore * 100:F0}")%
                                        </small>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(s.SuggestedRole))
                                {
                                    <small class="text-muted d-block mb-1">роль контексту: @s.SuggestedRole</small>
                                }
                                <div class="d-flex flex-wrap gap-3 small mb-1">
                                    <span class="text-muted">частота @(s.Reasons.SameFrequency ? "✓" : "—")</span>
                                    <span class="text-muted">вектор @(s.Reasons.SameVector ? "✓" : "—")</span>
                                    <span class="text-muted">підрозділ @(s.Reasons.SameDivision ? "✓" : "—")</span>
                                    <span class="text-muted">роль @(s.Reasons.SameRole ? "✓" : "—")</span>
                                    @if (s.Reasons.PivotIntersection)
                                    {
                                        <span class="text-success">перехрестя ✓</span>
                                    }
                                    @if (s.Reasons.HasConfirmedContext)
                                    {
                                        <span class="text-success">є підтверджені ✓</span>
                                    }
                                </div>

                                @if (s.CommonLabels.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                        <span class="text-muted small">мітки:</span>
                                        @foreach (var label in s.CommonLabels)
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info"
                                                  style="font-size:.7rem">@label</span>
                                        }
                                    </div>
                                }

                                @if (s.RelatedResolvedNames.Count > 0)
                                {
                                    <small class="text-muted d-block">
                                        підтверджені в цьому контексті: @string.Join(", ", s.RelatedResolvedNames)
                                    </small>
                                }

                                @if (s.RelatedKnownNames.Count > 0)
                                {
                                    <small class="text-muted d-block">
                                        пов'язані відомі: @string.Join(", ", s.RelatedKnownNames)
                                    </small>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Узагальнені ознаки групи -->
                <div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-label form-label-sm text-muted mb-0">
                            Узагальнені ознаки
                        </div>
                        <small class="text-muted">
                            @Group.Refs.Count спостережень · @FeatureRows.Count унікальних наборів
                        </small>
                    </div>
                    <table class="table table-dark table-sm align-middle mb-0"
                           style="font-size:.8rem">
                        <thead>
                            <tr class="border-bottom border-secondary">
                                <th class="fw-normal text-secondary small">Частота</th>
                                <th class="fw-normal text-secondary small">Вектор</th>
                                <th class="fw-normal text-secondary small">Р/М</th>
                                <th class="fw-normal text-secondary small text-center">К-сть</th>
                                <th class="fw-normal text-secondary small">Період</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in FeatureRows)
                            {
                                <tr class="border-bottom border-secondary border-opacity-25">
                                    <td class="font-monospace">@(r.Frequency ?? "—")</td>
                                    <td>
                                        <span class="text-truncate d-block"
                                              style="max-width:160px"
                                              title="@r.VectorSignal">
                                            @(r.VectorSignal ?? "—")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-block"
                                              style="max-width:120px"
                                              title="@r.Division">
                                            @(r.Division ?? "—")
                                        </span>
                                    </td>
                                    <td class="text-center fw-medium">@r.Count</td>
                                    <td class="text-nowrap text-muted">
                                        @if (r.FirstObservedDate == r.LastObservedDate)
                                        {
                                            @ConverterDateTimeExtensions.ToDisplay(r.FirstObservedDate).ToString("dd.MM.yy HH:mm")
                                        }
                                        else
                                        {
                                            <span>
                                                @ConverterDateTimeExtensions.ToDisplay(r.FirstObservedDate).ToString("dd.MM.yy HH:mm")
                                                —
                                                @ConverterDateTimeExtensions.ToDisplay(r.LastObservedDate).ToString("dd.MM.yy HH:mm")
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Форма підтвердження — тільки для Open -->
                @if (Group.Status == CandidateGroupStatusDto.Open)
                {
                    <div class="border-top border-secondary">
                        <div class="form-label form-label-sm text-muted mb-2">
                            Підтвердити як відому особу
                        </div>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label form-label-sm">
                                    Позивний <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control form-control-sm @(_nameError ? "is-invalid" : "")"
                                       placeholder="напр. ШАПКА"
                                       value="@_confirmName"
                                       @oninput="e => { _confirmName = e.Value?.ToString(); _nameError = false; }" />
                                @if (_nameError)
                                {
                                    <div class="invalid-feedback">Позивний обов'язковий</div>
                                }
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">Роль</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="напр. центр (бпла)"
                                       value="@_confirmRole"
                                       @oninput="e => _confirmRole = e.Value?.ToString()" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">Підрозділ</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="напр. 1 мсб 656 мсп"
                                       value="@_confirmDivision"
                                       @oninput="e => _confirmDivision = e.Value?.ToString()" />
                            </div>
                        </div>
                    </div>
                }

                @if (_serverError is not null)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>@_serverError
                    </div>
                }

            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_saving">
            Закрити
        </button>
        @if (Group?.Status == CandidateGroupStatusDto.Open)
        {
            <button class="btn btn-outline-danger btn-sm"
                    @onclick="DismissAsync"
                    disabled="@_saving">
                <i class="bi bi-x-circle me-1"></i>Відхилити
            </button>
            <button class="btn btn-success btn-sm"
                    @onclick="ConfirmAsync"
                    disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-check-circle me-1"></i>Підтвердити
            </button>
        }
    </FooterContent>
</Drawer>
