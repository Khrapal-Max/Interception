@page "/analytics/day"
@page "/analytics/day/{DateText}"

<PageTitle>Картина дня</PageTitle>

<div class="container-fluid py-2 d-flex flex-column gap-2">
    <div class="card rounded-0 shadow-sm">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1">Дата</label>
                    <input type="date"
                           class="form-control form-control-sm rounded-0"
                           @bind="_dateInput" />
                </div>

                <div class="col-12 col-md-3">
                    <button class="btn btn-primary btn-sm rounded-0"
                            @onclick="LoadAsync"
                            disabled="@_loading">
                        Показати
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="card rounded-0 shadow-sm">
            <div class="card-body text-muted text-center py-5">Завантаження…</div>
        </div>
    }
    else if (_dto is null)
    {
        <div class="alert alert-warning rounded-0 mb-0">Дані не знайдено.</div>
    }
    else
    {
        <div class="row g-2">
            <div class="col-12 col-xxl-9 d-flex flex-column gap-2">
                @foreach (var line in _dto.Lines)
                {
                    <div class="card rounded-0 shadow-sm">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@line.Title</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var signal in line.Signals)
                                {
                                    <span class="badge text-bg-light border rounded-0">@signal</span>
                                }
                            </div>
                        </div>

                        <div class="card-body py-2">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var obs in line.Observations)
                                {
                                    <div class="border rounded-0 p-2">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">@obs.ActionRaw</div>
                                                <div class="small text-muted">
                                                    @(obs.DayPart == 2 ? "PM" : "AM")
                                                    · @(obs.RmRaw ?? "—")
                                                    · @(obs.Layer ?? "—")
                                                </div>
                                            </div>

                                            <a class="btn btn-sm btn-outline-secondary rounded-0"
                                                   href="/observations">
                                                Реєстр
                                            </a>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(obs.Note))
                                        {
                                            <div class="small mt-2">@obs.Note</div>
                                        }

                                        @if (obs.Participants.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var p in obs.Participants)
                                                {
                                                    <span class="badge text-bg-light border rounded-0">@p</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-12 col-xxl-3 d-flex flex-column gap-2">
                <div class="card rounded-0 shadow-sm">
                    <div class="card-header py-2">Кого аналізувати першим</div>
                    <div class="card-body py-2">
                        @if (_dto.TopCandidates.Count == 0)
                        {
                            <div class="text-muted small">Кандидатів не знайдено.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var candidate in _dto.TopCandidates)
                                {
                                    <div class="border rounded-0 p-2">
                                        <div class="fw-semibold">@candidate.DisplayName</div>
                                        <div class="small text-muted">
                                            Score: @candidate.PriorityScore · @GetReadinessText(candidate.Readiness)
                                        </div>

                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @foreach (var signal in candidate.TopSignals)
                                            {
                                                <span class="badge text-bg-light border rounded-0">@signal</span>
                                            }
                                        </div>

                                        <div class="mt-2">
                                            @if (candidate.ClusterId is not null)
                                            {
                                                <a class="btn btn-sm btn-outline-primary rounded-0"
                                                       href="@($"/analytics/clusters/{candidate.ClusterId}")">
                                                    Припущення
                                                </a>
                                            }
                                            else if (candidate.ParticipantId is not null)
                                            {
                                                <a class="btn btn-sm btn-outline-primary rounded-0"
                                                       href="@($"/analytics/participants/{candidate.ParticipantId}")">
                                                    Аналіз
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>