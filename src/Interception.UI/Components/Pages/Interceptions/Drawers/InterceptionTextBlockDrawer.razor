@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Application.Interceptions.TextBlock
@using Interception.UI.Components.Shared.Drawer
@using Interception.UI.Domain
@using Interception.UI.Extensions
@namespace Interception.UI.Components.Pages.Interceptions.Drawers

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="Додати з тексту"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>

        @if (_parsed is null)
        {
            <!-- Крок 1: вставка тексту -->
            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label form-label-sm">Вставте текстовий блок</label>
                    <textarea class="form-control font-monospace"
                              rows="12"
                              placeholder="21.03.2026, 09:15:50&#10;410.1370&#10;УКХ р/м ім. 3 кулб 69 обрп (р-н Маліївка - Січневе)&#10;ЗВЕЗДА&#10;ЦЫГАН, ПАНДА&#10;— діалог..."
                              value="@_rawText"
                              @oninput="e => { _rawText = e.Value?.ToString(); _parseError = null; }">
                    </textarea>
                    @if (_parseError is not null)
                    {
                        <div class="text-danger small mt-1">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_parseError
                        </div>
                    }
                </div>
                <div class="alert alert-light border small py-2 px-3 mb-0">
                    <div class="fw-semibold mb-1">Очікуваний формат:</div>
                    <div class="text-muted">
                        Рядок 1: Дата, час &nbsp;·&nbsp;
                        Рядок 2: Частота &nbsp;·&nbsp;
                        Рядок 3: Р/М (вектор) &nbsp;·&nbsp;
                        Рядок 4: Ініціатор &nbsp;·&nbsp;
                        Рядок 5+: Відповідачі &nbsp;·&nbsp;
                        Далі: діалог
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Крок 2: перевірка розпізнаного + вибір дії -->
            <div class="row g-2">

                <div class="col-12 mb-1">
                    <button class="btn btn-link btn-sm p-0 text-muted"
                            @onclick="() => _parsed = null">
                        <i class="bi bi-arrow-left me-1"></i>Назад до тексту
                    </button>
                </div>

                <!-- Дата та час -->
                <div class="col-6">
                    <label class="form-label form-label-sm">Дата та час</label>
                    <input type="datetime-local" class="form-control form-control-sm"
                           value="@(_form!.ObservedDate != default ? DateTimeConverter.Format(_form.ObservedDate) : "")"
                           @onchange="OnObservedDateChange" />
                </div>

                <!-- Дія — вводить оператор -->
                <div class="col-6">
                    <label class="form-label form-label-sm">
                        Дія <span class="text-danger">*</span>
                    </label>
                    @if (Actions.Count == 0)
                    {
                        <div class="form-control form-control-sm text-muted"
                             style="background:var(--bs-secondary-bg)">
                            <span class="spinner-border spinner-border-sm me-1"></span>Завантаження…
                        </div>
                    }
                    else
                    {
                        <select class="form-select form-select-sm"
                                value="@_form.InterceptionActionId"
                                @onchange="OnActionChange">
                            <option value="@Guid.Empty">— оберіть дію —</option>
                            @foreach (var action in Actions)
                            {
                                <option value="@action.Id">@action.Name</option>
                            }
                        </select>
                    }
                </div>

                <!-- Частота -->
                <div class="col-6">
                    <label class="form-label form-label-sm">Частота</label>
                    <input type="text" class="form-control form-control-sm font-monospace"
                           value="@_form.Frequency"
                           @oninput="e => _form.Frequency = e.Value?.ToString()" />
                </div>

                <!-- Р/М -->
                <div class="col-6">
                    <label class="form-label form-label-sm">Р/М (підрозділ)</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@_form.Division"
                           @oninput="e => _form.Division = e.Value?.ToString()" />
                </div>

                <!-- Вектор -->
                <div class="col-12">
                    <label class="form-label form-label-sm">Вектор сигналу</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@_form.VectorSignal"
                           @oninput="e => _form.VectorSignal = e.Value?.ToString()" />
                </div>

                <!-- Учасники — показуємо розпізнаних, можна редагувати -->
                <div class="col-12 mt-1">
                    <label class="form-label form-label-sm mb-1">Учасники</label>

                    @foreach (var pt in _form.Participants.OrderBy(p => p.Ordinal))
                    {
                        var participant = pt;
                        <div class="row g-1 align-items-center mb-1">
                            <div class="col-auto text-muted small" style="width:22px">
                                @participant.Ordinal
                            </div>
                            <div class="col-auto">
                                <div class="form-check form-switch mb-0" title="Невідомий (НВ)">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@participant.IsUnknown"
                                           @onchange="e => OnUnknownToggle(participant, (bool)(e.Value ?? false))" />
                                </div>
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(participant.IsUnknown ? "НВ" : "Позивний")"
                                       disabled="@participant.IsUnknown"
                                       value="@participant.Name"
                                       @oninput="e => participant.Name = e.Value?.ToString()" />
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Роль"
                                       value="@participant.Role"
                                       @oninput="e => participant.Role = e.Value?.ToString()" />
                            </div>
                            <div class="col-auto">
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm py-0 px-1"
                                        @onclick="() => _form.Participants.Remove(participant)"
                                        disabled="@(_form.Participants.Count <= 1)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 mt-1"
                            @onclick="AddParticipant">
                        <i class="bi bi-person-plus me-1"></i>Додати
                    </button>
                </div>

                <!-- Нотатка -->
                <div class="col-12">
                    <label class="form-label form-label-sm">Деталі / нотатка</label>
                    <textarea class="form-control form-control-sm" rows="4"
                              value="@_form.Note"
                              @oninput="e => _form.Note = e.Value?.ToString()"></textarea>
                </div>

            </div>
        }

    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_saving">
            Скасувати
        </button>

        @if (_parsed is null)
        {
            <button class="btn btn-primary btn-sm"
                    @onclick="ParseAsync"
                    disabled="@string.IsNullOrWhiteSpace(_rawText)">
                <i class="bi bi-magic me-1"></i>Розпізнати
            </button>
        }
        else
        {
            <button class="btn btn-primary btn-sm"
                    @onclick="SaveAsync"
                    disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Зберегти
            </button>
        }
    </FooterContent>
</Drawer>
