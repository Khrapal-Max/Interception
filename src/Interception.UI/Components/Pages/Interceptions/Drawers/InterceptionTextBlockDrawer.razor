@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Components.Shared.Drawer
@using Interception.UI.Extensions
@using Interception.UI.Domain
@using Microsoft.AspNetCore.Components.Web

<Drawer Title="Імпорт з тексту"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        OnClosed="OnDrawerClosed"
        Width="DrawerWidth.Large"
        VerticalScroll="true"
        CloseOnBackdrop="true"
        CloseOnEscape="true">

    <ChildContent>

        @if (_parsed is null)
        {
            <div class="mb-2 small text-muted">
                Вставте сирий текст перехоплення. Парсер спробує витягнути дату, частоту,
                напрямок/вектор, можливий підрозділ та учасників.
            </div>

            <textarea class="form-control font-monospace mb-2"
                      rows="12"
                      @bind="_rawText"></textarea>

            @if (!string.IsNullOrWhiteSpace(_parseError))
            {
                <div class="alert alert-danger py-2 mb-0">@_parseError</div>
            }
        }
        else if (_form is not null)
        {
            <div class="row g-2">

                <!-- Дата/час -->
                <div class="col-4">
                    <label class="form-label form-label-sm">Дата/час</label>
                    <input type="datetime-local"
                           class="form-control form-control-sm"
                           value="@ConverterDateTimeExtensions.ToInputString(_form.ObservedDate)"
                           @onchange="OnObservedDateChange" />
                </div>

                <!-- Дія -->
                <div class="col-5">
                    <label class="form-label form-label-sm">Дія</label>
                    <select class="form-select form-select-sm"
                            value="@_form.InterceptionActionId"
                            @onchange="OnActionChange">
                        <option value="@Guid.Empty">— оберіть дію —</option>
                        @foreach (var action in Actions)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    </select>
                </div>

                <!-- Частота -->
                <div class="col-3">
                    <label class="form-label form-label-sm">Частота</label>
                    <input class="form-control form-control-sm"
                           value="@_form.Frequency"
                           @oninput="e => _form.Frequency = e.Value?.ToString()" />
                </div>

                <!-- Підрозділ -->
                <div class="col-6">
                    <label class="form-label form-label-sm">Р/М (підрозділ)</label>
                    <input class="form-control form-control-sm"
                           value="@_form.Division"
                           @oninput="e => _form.Division = e.Value?.ToString()" />
                </div>

                <!-- Вектор -->
                <div class="col-6">
                    <label class="form-label form-label-sm">Вектор сигналу</label>
                    <input class="form-control form-control-sm"
                           value="@_form.VectorSignal"
                           @oninput="e => _form.VectorSignal = e.Value?.ToString()" />
                </div>

                <div class="col-12 mt-1">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <label class="form-label form-label-sm mb-1">Учасники</label>
                        <button type="button" class="btn btn-warning btn-sm py-0 mt-1"
                                @onclick="AddParticipant">
                            <i class="bi bi-person-plus me-1"></i>Додати
                        </button>
                    </div>
                    @foreach (var pt in _form.Participants.OrderBy(p => p.Ordinal))
                    {
                        var participant = pt;
                        <div class="row g-1 align-items-center mb-1">
                            <div class="col-auto text-muted small" style="width:22px">
                                @participant.Ordinal
                            </div>
                            <div class="col-auto">
                                <div class="form-check form-switch mb-0" title="Невідомий (НВ)">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@participant.IsUnknown"
                                           @onchange="e => OnUnknownToggle(participant, (bool)(e.Value ?? false))" />
                                </div>
                            </div>
                            <div class="col autocomplete-wrap">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(participant.IsUnknown ? "НВ" : "Позивний")"
                                       disabled="@participant.IsUnknown"
                                       value="@participant.Name"
                                       autocomplete="off"
                                       @oninput="e => OnParticipantNameInput(participant, e.Value?.ToString())"
                                       @onchange="e => OnParticipantNameChangedAsync(participant, e.Value?.ToString())"
                                       @onblur="() => CloseParticipantSuggestions(participant.Ordinal)" />

                                @if (_participantOpen.Contains(participant.Ordinal)
                                     && _participantSuggestions.TryGetValue(participant.Ordinal, out var sugs)
                                     && sugs.Count > 0 && !participant.IsUnknown)
                                {
                                    <ul class="autocomplete-list">
                                        @foreach (var suggestion in sugs.Take(6))
                                        {
                                            var item = suggestion;
                                            <li class="autocomplete-item"
                                                @onmousedown:preventDefault
                                                @onmousedown="() => ApplyParticipantSuggestion(participant, item)">
                                                <div class="d-flex justify-content-between align-items-start gap-2">
                                                    <div class="d-flex flex-column">
                                                        <span class="font-monospace fw-semibold">@item.Name</span>
                                                        <small class="text-muted">
                                                            @(string.IsNullOrWhiteSpace(item.Frequency) ? "частота не вказана" : item.Frequency)
                                                            @if (!string.IsNullOrWhiteSpace(item.Division))
                                                            {
                                                                <span> · @item.Division</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                                            {
                                                                <span> · @item.Role</span>
                                                            }
                                                        </small>
                                                    </div>
                                                    <small class="text-muted text-nowrap">@item.SeenCount</small>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Роль"
                                       value="@participant.Role"
                                       @oninput="e => participant.Role = e.Value?.ToString()" />
                            </div>
                            <div class="col-auto">
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm py-0 px-1"
                                        @onclick="() => RemoveParticipant(participant)"
                                        disabled="@(_form.Participants.Count <= 1)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Нотатка -->
                <div class="col-12">
                    <label class="form-label form-label-sm">Деталі / нотатка</label>
                    <textarea class="form-control form-control-sm" rows="4"
                              value="@_form.Note"
                              @oninput="e => _form.Note = e.Value?.ToString()"></textarea>
                </div>

                <!-- Мітки -->
                <div class="col-12 mt-1">
                    <label class="form-label form-label-sm mb-1">Мітки</label>

                    <div class="input-group input-group-sm mb-2">
                        <input type="text"
                               class="form-control"
                               placeholder="Додати мітку"
                               value="@_newLabel"
                               @oninput="e => _newLabel = e.Value?.ToString()"
                               @onkeydown="OnLabelKeyDown" />
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="AddLabel"
                                disabled="@string.IsNullOrWhiteSpace(_newLabel)">
                            <i class="bi bi-plus-lg me-1"></i>Додати
                        </button>
                    </div>

                    @if (_form.Labels.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var label in _form.Labels)
                            {
                                <span class="badge text-bg-secondary d-inline-flex align-items-center gap-1 px-2 py-2">
                                    <span>@label</span>
                                    <button type="button"
                                            class="btn btn-sm btn-link text-white text-decoration-none p-0 border-0"
                                            title="Видалити мітку"
                                            @onclick="() => RemoveLabel(label)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>

            </div>
        }

    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@(_saving || _form is null || _form.InterceptionActionId == Guid.Empty)">
            Скасувати
        </button>

        @if (_parsed is null)
        {
            <button class="btn btn-primary btn-sm"
                    @onclick="ParseAsync"
                    disabled="@string.IsNullOrWhiteSpace(_rawText)">
                <i class="bi bi-magic me-1"></i>Розпізнати
            </button>
        }
        else
        {
            <button class="btn btn-primary btn-sm"
                    @onclick="SaveAsync"
                    disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Зберегти
            </button>
        }
    </FooterContent>
</Drawer>
