@using Interception.UI.Components.Shared.Drawer
@namespace Interception.UI.Components.Pages.Interceptions.Drawers

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="Імпорт з Excel"
        DisableClose="@_importing"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        <div class="d-flex flex-column gap-3">

            <div>
                <label class="form-label form-label-sm">Excel-файл</label>
                <InputFile class="form-control form-control-sm"
                           accept=".xlsx,.xls,.xlsm,.xlsb"
                           OnChange="OnFileSelected" />
                @if (_fileName is not null)
                {
                    <div class="form-text text-success mt-1">
                        <i class="bi bi-file-earmark-excel me-1"></i>@_fileName
                    </div>
                }
            </div>

            <div class="alert alert-light border py-2 px-3 mb-0 small">
                <div class="fw-semibold mb-1">Очікуваний формат:</div>
                <div class="text-muted">
                    Імпорт читає аркуш <strong>«Спостереження»</strong> у тому самому форматі,
                    який дає поточний Excel-експорт зі сторінки спостережень.
                </div>
                <div class="mt-1 text-muted">
                    Ключові колонки: Дата/час · Частота · Підрозділ · Вектор · Точка · Дія · Примітка · Учасники · Мітки.
                </div>
                <div class="mt-1 text-muted">
                    Unknown-учасники у вигляді <strong>НВ 1</strong>, <strong>НВ 2</strong> тощо зберігаються як невідомі особи.
                </div>
            </div>

            @if (_lastResult is not null)
            {
                <div class="alert @(_lastResult.HasErrors ? "alert-warning" : "alert-success") py-2 px-3 mb-0 small">
                    <strong>Імпортовано:</strong> @_lastResult.ImportedCount
                    &nbsp;|&nbsp;
                    <strong>Пропущено:</strong> @_lastResult.SkippedCount
                    @if (_lastResult.HasErrors)
                    {
                        <ul class="mb-0 mt-1 ps-3">
                            @foreach (var err in _lastResult.Errors.Take(10))
                            {
                                <li>Рядок @err.RowNumber: @err.Message</li>
                            }
                            @if (_lastResult.Errors.Count > 10)
                            {
                                <li class="text-muted">… ще @(_lastResult.Errors.Count - 10) помилок</li>
                            }
                        </ul>
                    }
                </div>
            }

        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_importing">
            Закрити
        </button>
        <button class="btn btn-success btn-sm"
                @onclick="RunImportAsync"
                disabled="@(_importing || _file is null)">
            @if (_importing)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Імпортувати
        </button>
    </FooterContent>
</Drawer>
