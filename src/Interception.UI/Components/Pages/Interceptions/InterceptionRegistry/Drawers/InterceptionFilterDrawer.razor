@using Interception.UI.Application.Interceptions.Dtos

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="Фільтр"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        <div class="row g-2">

            <div class="col-6">
                <label class="form-label form-label-sm">Дата від</label>
                <input type="datetime-local" class="form-control form-control-sm"
                       value="@DateFromStr"
                       @onchange="e => OnDateFromChange(e.Value?.ToString())" />
            </div>

            <div class="col-6">
                <label class="form-label form-label-sm">Дата до</label>
                <input type="datetime-local" class="form-control form-control-sm"
                       value="@DateToStr"
                       @onchange="e => OnDateToChange(e.Value?.ToString())" />
            </div>

            <!-- Частота — autocomplete -->
            <div class="col-6">
                <label class="form-label form-label-sm">Частота</label>
                <div class="autocomplete-wrap">
                    <input type="text" class="form-control form-control-sm font-monospace"
                           placeholder="напр. 157.0250"
                           value="@_model.Frequency"
                           autocomplete="off"
                           @oninput="OnFrequencyInput"
                           @onfocus="OnFrequencyFocus"
                           @onblur="() => _freqOpen = false" />
                    @if (_freqOpen && _frequencySuggestions.Count > 0)
                    {
                        <ul class="autocomplete-list">
                            @foreach (var freq in _frequencySuggestions)
                            {
                                var f = freq;
                                <li class="autocomplete-item"
                                    @onmousedown:preventDefault
                                    @onmousedown="() => OnFrequencySelected(f)">
                                    <span class="font-monospace fw-semibold">@f</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Вектор — autocomplete -->
            <div class="col-6">
                <label class="form-label form-label-sm">Вектор сигналу</label>
                <div class="autocomplete-wrap">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="напр. степове-олексіївка"
                           value="@_model.VectorSignal"
                           autocomplete="off"
                           @oninput="OnVectorInput"
                           @onfocus="OnVectorFocus"
                           @onblur="() => _vecOpen = false" />
                    @if (_vecOpen && _vectorSuggestions.Count > 0)
                    {
                        <ul class="autocomplete-list">
                            @foreach (var vec in _vectorSuggestions)
                            {
                                var v = vec;
                                <li class="autocomplete-item"
                                    @onmousedown:preventDefault
                                    @onmousedown="() => OnVectorSelected(v)">
                                    @v
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="col-12">
                <label class="form-label form-label-sm">Учасник</label>
                <input type="text" class="form-control form-control-sm"
                       placeholder="Частина позивного…"
                       value="@_model.ParticipantName"
                       @oninput="e => _model.ParticipantName = e.Value?.ToString()" />
            </div>

            <div class="col-12">
                <label class="form-label form-label-sm">Мітка</label>
                <input type="text" class="form-control form-control-sm"
                       value="@_model.LabelName"
                       @oninput="e => _model.LabelName = e.Value?.ToString()" />
            </div>

        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetAsync">
            <i class="bi bi-x-circle me-1"></i>Скинути
        </button>
        <button class="btn btn-primary btn-sm" @onclick="ApplyAsync">
            <i class="bi bi-funnel me-1"></i>Застосувати
        </button>
    </FooterContent>
</Drawer>
