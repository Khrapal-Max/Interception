@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Application.Registry.Dtos
@using Interception.UI.Components.Shared.DirectiveRelationEditor
@using Interception.UI.Extensions

<Drawer Title="Імпорт з тексту"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        OnClosed="OnDrawerClosed"
        CloseOnBackdrop="true"
        CloseOnEscape="true">

    <ChildContent>
        @if (_parsed is null)
        {
            <div class="mb-3">
                <div class="small text-muted">
                    Вставте сирий текст перехоплення. Парсер спробує витягнути дату, час, частоту,
                    підрозділ, вектор та учасників.
                </div>

                <label class="form-label">Текст перехоплення</label>
                <textarea class="form-control font-monospace"
                          rows="14"
                          @bind="_rawText"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(_parseError))
            {
                <div class="alert alert-danger mb-0">
                    @_parseError
                </div>
            }
        }
        else if (_form is not null)
        {
            <div class="row g-1">
                <div class="col-6">
                    <label class="form-label">Дата/час</label>
                    <input type="datetime-local"
                           class="form-control"
                           value="@ConverterDateTimeExtensions.Format(_form.ObservedDate)"
                           @onchange="OnObservedDateChange" />
                </div>

                <div class="col-6">
                    <label class="form-label">Дія</label>
                    <select class="form-select"
                            value="@_form.InterceptionActionId"
                            @onchange="OnActionChange">
                        <option value="@Guid.Empty">— оберіть дію —</option>
                        @foreach (var action in Actions)
                        {
                            <option value="@action.Id">@action.Name</option>
                        }
                    </select>
                </div>

                <div class="col-6">
                    <label class="form-label">Частота</label>
                    <input class="form-control"
                           value="@_form.Frequency"
                           @oninput="e => _form.Frequency = e.Value?.ToString()" />
                </div>

                <div class="col-6">
                    <label class="form-label">Р/М (підрозділ)</label>
                    <input class="form-control"
                           value="@_form.Division"
                           @oninput="e => _form.Division = e.Value?.ToString()" />
                </div>

                <div class="col-12">
                    <label class="form-label">Вектор сигналу</label>
                    <input class="form-control"
                           value="@_form.VectorSignal"
                           @oninput="e => _form.VectorSignal = e.Value?.ToString()" />
                </div>

                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label mb-0">Учасники</label>
                        <button type="button"
                                class="btn btn-warning btn-sm"
                                @onclick="AddParticipant">
                            <i class="bi bi-person-plus me-1"></i>Додати
                        </button>
                    </div>

                    @foreach (var pt in _form.Participants.OrderBy(p => p.Ordinal))
                    {
                        var participant = pt;

                        <div class="row g-1 align-items-center">
                            <div class="col-auto">
                                <span class="text-muted small">#@participant.Ordinal</span>
                            </div>

                            <div class="col-auto">
                                <div class="form-check form-switch mb-0" title="Невідомий учасник">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@participant.IsUnknown"
                                           @onchange="e => OnUnknownToggle(participant, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label">НВ</label>
                                </div>
                            </div>

                            <div class="col-md-5 autocomplete-wrap">
                                <input type="text"
                                       class="form-control"
                                       placeholder="@(participant.IsUnknown ? "НВ" : "Позивний")"
                                       disabled="@participant.IsUnknown"
                                       value="@participant.Name"
                                       autocomplete="off"
                                       @oninput="e => OnParticipantNameInput(participant, e.Value?.ToString())"
                                       @onchange="e => OnParticipantNameChangedAsync(participant, e.Value?.ToString())"
                                       @onblur="() => CloseParticipantSuggestions(participant.Ordinal)" />

                                @if (_participantOpen.Contains(participant.Ordinal)
                                    && _participantSuggestions.TryGetValue(participant.Ordinal, out var suggestions)
                                    && suggestions.Count > 0
                                    && !participant.IsUnknown)
                                {
                                    <ul class="autocomplete-list">
                                        @foreach (var suggestion in suggestions.Take(6))
                                        {
                                            var item = suggestion;
                                            <li class="autocomplete-item"
                                                @onmousedown:preventDefault
                                                @onmousedown="() => ApplyParticipantSuggestion(participant, item)">
                                                <div class="d-flex justify-content-between align-items-start gap-1">
                                                    <div class="d-flex flex-column">
                                                        <span class="font-monospace fw-semibold">@item.Name</span>
                                                        <small class="text-muted">
                                                            @(string.IsNullOrWhiteSpace(item.Frequency) ? "частота не вказана" : item.Frequency)
                                                            @if (!string.IsNullOrWhiteSpace(item.Division))
                                                            {
                                                                <span> · @item.Division</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                                            {
                                                                <span> · @item.Role</span>
                                                            }
                                                        </small>
                                                    </div>
                                                    <small class="text-muted text-nowrap">@item.SeenCount</small>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div class="col-md-5">
                                <input type="text"
                                       class="form-control"
                                       placeholder="Роль"
                                       value="@participant.Role"
                                       list="participant-role-catalog-textblock"
                                       @oninput="e => OnParticipantRoleInput(participant, e.Value?.ToString())"
                                       @onchange="e => OnParticipantRoleChanged(participant, e.Value?.ToString())" />
                            </div>

                            <div class="col-auto">
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        @onclick="() => RemoveParticipant(participant)"
                                        disabled="@(_form.Participants.Count <= 1)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                    }

                    @if (_roleSuggestions.Count > 0)
                    {
                        <datalist id="participant-role-catalog-textblock">
                            @foreach (var role in _roleSuggestions)
                            {
                                <option value="@role"></option>
                            }
                        </datalist>
                    }
                </div>

                <div class="col-12">
                    <DirectiveRelationEditor IdPrefix="text"
                                             HintText="Тимчасовий inline-блок (Stage 1): фіксація керування під час створення observation з тексту."
                                             Enabled="_directiveEnabled"
                                             EnabledChanged="OnDirectiveEnabledChanged"
                                             Loading="_directiveLoading"
                                             Saving="_saving"
                                             Options="_directiveOptions"
                                             Form="_directiveForm"
                                             FromSelection="_directiveFromSelection"
                                             FromSelectionChanged="OnDirectiveFromSelectionChanged"
                                             ToSelection="_directiveToSelection"
                                             ToSelectionChanged="OnDirectiveToSelectionChanged"
                                             OnRefreshOptions="LoadDirectiveOptionsAsync" />
                </div>

                <div class="col-12">
                    <label class="form-label">Деталі / нотатка</label>
                    <textarea class="form-control"
                              rows="5"
                              value="@_form.Note"
                              @oninput="e => _form.Note = e.Value?.ToString()"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Мітки</label>

                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               placeholder="Додати мітку"
                               value="@_newLabel"
                               @oninput="e => _newLabel = e.Value?.ToString()"
                               @onkeydown="OnLabelKeyDown" />
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="AddLabel"
                                disabled="@string.IsNullOrWhiteSpace(_newLabel)">
                            <i class="bi bi-plus-lg me-1"></i>Додати
                        </button>
                    </div>

                    @if (_form.Labels.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var label in _form.Labels)
                            {
                                <span class="badge text-bg-secondary d-inline-flex align-items-center gap-1 px-2 py-2">
                                    <span>@label</span>
                                    <button type="button"
                                            class="btn btn-sm btn-link text-white text-decoration-none p-0 border-0"
                                            title="Видалити мітку"
                                            @onclick="() => RemoveLabel(label)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </ChildContent>

    <FooterContent>
        <button class="btn btn-secondary"
                @onclick="CloseAsync"
                disabled="@_saving">
            Скасувати
        </button>

        @if (_parsed is null)
        {
            <button class="btn btn-primary"
                    @onclick="ParseAsync"
                    disabled="@string.IsNullOrWhiteSpace(_rawText)">
                <i class="bi bi-magic me-1"></i>Розпізнати
            </button>
        }
        else
        {
            <button class="btn btn-success"
                    @onclick="SaveAsync"
                    disabled="@(_saving || _form?.InterceptionActionId == Guid.Empty)">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Зберегти
            </button>
        }
    </FooterContent>
</Drawer>
