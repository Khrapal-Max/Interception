@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Application.Registry.Dtos
@using Interception.UI.Components.Shared.Drawer
@using Interception.UI.Components.Shared.DirectiveRelationEditor
@using Interception.UI.Extensions

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="@(EditingId.HasValue ? "Редагування" : "Нове повідомлення")"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <HeaderActions>
        @if (EditingId.HasValue)
        {
            <span class="badge bg-secondary me-2">Редагування</span>
        }
    </HeaderActions>
    <ChildContent>
        @if (_form is not null)
        {
            <div class="d-flex flex-column gap-3">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label form-label-sm">Дата та час</label>
                        <input type="datetime-local" class="form-control form-control-sm"
                               value="@ConverterDateTimeExtensions.Format(_form.ObservedDate)"
                               @onchange="OnObservedDateChange" />
                    </div>

                    <div class="col-6">
                        <label class="form-label form-label-sm">
                            Дія <span class="text-danger">*</span>
                        </label>
                        @if (_actions.Count == 0)
                        {
                            <div class="form-control form-control-sm text-muted"
                                 style="background:var(--bs-secondary-bg)">
                                <span class="spinner-border spinner-border-sm me-1"></span>Завантаження…
                            </div>
                        }
                        else
                        {
                            <select class="form-select form-select-sm"
                                    value="@_form.InterceptionActionId"
                                    @onchange="OnActionChange">
                                <option value="@Guid.Empty">— оберіть дію —</option>
                                @foreach (var action in _actions)
                                {
                                    <option value="@action.Id">@action.Name</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="col-6">
                        <label class="form-label form-label-sm">Частота</label>
                        <div class="autocomplete-wrap">
                            <input type="text" class="form-control form-control-sm font-monospace"
                                   placeholder="напр. 157.0250"
                                   value="@_form.Frequency"
                                   autocomplete="off"
                                   @oninput="OnFrequencyInput"
                                   @onfocus="OnFrequencyFocus"
                                   @onblur="OnFrequencyBlur" />
                            @if (_freqOpen && _frequencySuggestions.Count > 0)
                            {
                                <ul class="autocomplete-list">
                                    @foreach (var sug in _frequencySuggestions)
                                    {
                                        var s = sug;
                                        <li class="autocomplete-item"
                                            @onmousedown:preventDefault
                                            @onmousedown="() => OnFrequencySuggestionSelected(s)">
                                            <span class="font-monospace fw-semibold">@s.Frequency</span>
                                            @if (!string.IsNullOrWhiteSpace(s.Division))
                                            {
                                                <small class="font-monospace fw-semibold ms-2">@s.Division</small>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <div class="col-6">
                        <label class="form-label form-label-sm">Р/М (підрозділ)</label>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="напр. 1 мсб 656 мсп"
                               value="@_form.Division"
                               @oninput="e => _form.Division = e.Value?.ToString()" />
                    </div>

                    <div class="col-8">
                        <label class="form-label form-label-sm">Вектор сигналу</label>
                        <div class="autocomplete-wrap">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="напр. степове-олексіївка"
                                   value="@_form.VectorSignal"
                                   autocomplete="off"
                                   @oninput="OnVectorInput"
                                   @onfocus="OnVectorFocus"
                                   @onblur="OnVectorBlur" />
                            @if (_vecOpen && _vectorSuggestions.Count > 0)
                            {
                                <ul class="autocomplete-list">
                                    @foreach (var vec in _vectorSuggestions)
                                    {
                                        var v = vec;
                                        <li class="autocomplete-item"
                                            @onmousedown:preventDefault
                                            @onmousedown="() => { _form.VectorSignal = v; _vecOpen = false; }">
                                            <span class="font-monospace fw-semibold">@v</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <div class="col-4">
                        <label class="form-label form-label-sm">Точка перехвату</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@_form.PointSignal"
                               @oninput="e => _form.PointSignal = e.Value?.ToString()" />
                    </div>

                    <div class="col-12 mt-1">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label form-label-sm mb-0">Учасники</label>
                            <button type="button" class="btn btn-warning btn-sm py-0"
                                    @onclick="AddParticipant">
                                <i class="bi bi-person-plus me-1"></i>Додати
                            </button>
                        </div>

                        @foreach (var pt in _form.Participants.OrderBy(x => x.Ordinal))
                        {
                            var participant = pt;
                            <div class="row g-1 align-items-center mb-1">
                                <div class="col-auto text-muted small" style="width:22px">@participant.Ordinal</div>

                                <div class="col-auto">
                                    <div class="form-check form-switch mb-0" title="Невідомий (НВ)">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@participant.IsUnknown"
                                               @onchange="e => OnUnknownToggle(participant, (bool)(e.Value ?? false))" />
                                    </div>
                                </div>

                                <div class="col autocomplete-wrap">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="@(participant.IsUnknown ? "НВ" : "Позивний")"
                                           disabled="@participant.IsUnknown"
                                           value="@participant.Name"
                                           autocomplete="off"
                                           @oninput="e => OnParticipantNameInput(participant, e.Value?.ToString())"
                                           @onchange="e => OnParticipantNameChangedAsync(participant, e.Value?.ToString())"
                                           @onblur="() => CloseParticipantSuggestions(participant.Ordinal)" />

                                    @if (_participantOpen.Contains(participant.Ordinal)
                                        && _participantSuggestions.TryGetValue(participant.Ordinal, out var sugs)
                                        && sugs.Count > 0 && !participant.IsUnknown)
                                    {
                                        <ul class="autocomplete-list">
                                            @foreach (var sug in sugs.Take(6))
                                            {
                                                var s = sug;
                                                <li class="autocomplete-item"
                                                    @onmousedown:preventDefault
                                                    @onmousedown="() => ApplyParticipantSuggestion(participant, s)">
                                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                                        <div class="d-flex flex-column">
                                                            <span class="font-monospace fw-semibold">@s.Name</span>
                                                            <small class="text-muted">
                                                                @(string.IsNullOrWhiteSpace(s.Frequency) ? "частота не вказана" : s.Frequency)
                                                                @if (!string.IsNullOrWhiteSpace(s.Division))
                                                                {
                                                                    <span> · @s.Division</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(s.Role))
                                                                {
                                                                    <span> · @s.Role</span>
                                                                }
                                                            </small>
                                                        </div>
                                                        <small class="text-muted text-nowrap">@s.SeenCount</small>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                <div class="col">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Роль"
                                           value="@participant.Role"
                                           list="participant-role-catalog"
                                           @oninput="e => OnParticipantRoleInput(participant, e.Value?.ToString())"
                                           @onchange="e => OnParticipantRoleChanged(participant, e.Value?.ToString())" />
                                </div>

                                <div class="col-auto">
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                            @onclick="() => RemoveParticipant(participant)"
                                            disabled="@(_form.Participants.Count <= 1)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_roleSuggestions.Count > 0)
                        {
                            <datalist id="participant-role-catalog">
                                @foreach (var role in _roleSuggestions)
                                {
                                    <option value="@role"></option>
                                }
                            </datalist>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label form-label-sm">Деталі / нотатка</label>
                        <textarea class="form-control form-control-sm" rows="2"
                                  value="@_form.Note"
                                  @oninput="e => _form.Note = e.Value?.ToString()"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label form-label-sm">Мітки</label>

                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control"
                                   placeholder="напр. бпс, арт, логістика"
                                   value="@_newLabel"
                                   @oninput="e => _newLabel = e.Value?.ToString()"
                                   @onkeydown="OnLabelKeyDown" />
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="AddLabel">
                                Додати
                            </button>
                        </div>

                        @if (_form.Labels.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var label in _form.Labels)
                                {
                                    <span class="badge bg-secondary">
                                        @label
                                        <button type="button"
                                                class="btn btn-sm btn-link text-white text-decoration-none ms-1 p-0"
                                                @onclick="() => _form.Labels.Remove(label)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <DirectiveRelationEditor IdPrefix="form"
                                         HintText="Тимчасовий inline-блок (Stage 1): фіксація керування в основному дравері observation."
                                         Enabled="_directiveEnabled"
                                         EnabledChanged="OnDirectiveEnabledChanged"
                                         Loading="_directiveLoading"
                                         Saving="_saving"
                                         Options="_directiveOptions"
                                         Form="_directiveForm"
                                         FromSelection="_directiveFromSelection"
                                         FromSelectionChanged="OnDirectiveFromSelectionChanged"
                                         ToSelection="_directiveToSelection"
                                         ToSelectionChanged="OnDirectiveToSelectionChanged"
                                         OnRefreshOptions="LoadDirectiveOptionsAsync" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_saving">
            Скасувати
        </button>
        <button class="btn btn-primary btn-sm"
                @onclick="SaveAsync"
                disabled="@(_saving || _form is null || _form.InterceptionActionId == Guid.Empty)">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Зберегти
        </button>
    </FooterContent>
</Drawer>
