@page "/observations"
@using Interception.UI.Application.Exports.Models
@using Interception.UI.Components.Pages.Interceptions.InterceptionRegistry.Drawers
@using Interception.UI.Extensions

<PageTitle>Журнал спостережень</PageTitle>

<div class="page-shell">
    <div class="registry-toolbar flex-shrink-0">
        <div class="registry-toolbar-meta text-start">
            @if (_pagedResult is not null)
            {
                <span>Записів: <strong>@_pagedResult.TotalCount</strong></span>
            }
            @if (HasActiveFilter)
            {
                <span class="badge text-bg-warning ms-2">Фільтр активний</span>
            }
        </div>

        <div class="toolbar-actions d-flex align-items-center gap-2 justify-content-end ms-auto">
            <div class="toolbar-action-cluster toolbar-action-cluster-primary" role="group" aria-label="Пріоритетні дії">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenTextBlock">
                    <i class="bi bi-text-paragraph me-1"></i>З тексту
                </button>
                <button type="button" class="btn btn-success btn-sm" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg me-1"></i>Додати
                </button>
            </div>

            <div class="toolbar-action-cluster" role="group" aria-label="Дії з даними">
                <button type="button" class="btn btn-light btn-sm" @onclick="OpenFilter">
                    <i class="bi bi-funnel me-1"></i>Фільтр
                </button>
                <button type="button" class="btn btn-light btn-sm" @onclick="OpenImport">
                    <i class="bi bi-upload me-1"></i>Імпорт
                </button>
                <ExportLauncher Kind="ExportKind.Interceptions"
                                Title=".xlsx"
                                ButtonClass="btn btn-outline-secondary btn-sm" />
            </div>
        </div>
    </div>

    <div class="page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_pagedResult is null || _pagedResult.TotalCount == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                    <div>Записів не знайдено</div>
                    @if (HasActiveFilter)
                    {
                        <button class="btn btn-link btn-sm mt-2" @onclick="ResetFilter">
                            Скинути фільтр
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover table-sm align-middle data-table">
                    <thead>
                        <tr>
                            <th>Дата / Час</th>
                            <th>Частота</th>
                            <th>Р/М</th>
                            <th>Вектор</th>
                            <th>Учасники</th>
                            <th>Дія</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _pagedResult.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@ConverterDateTimeExtensions.ToDisplay(item.ObservedDate).ToString("dd.MM.yy HH:mm")</td>
                                <td>@(item.Frequency ?? "—")</td>
                                <td>@(item.Division ?? "—")</td>
                                <td>
                                    <span class="text-truncate d-block" style="max-width: 16rem" title="@item.VectorSignal">
                                        @(item.VectorSignal ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var pt in item.Participants.OrderBy(x => x.Ordinal))
                                        {
                                            <span class="badge @(pt.IsUnknown ? "bg-secondary" : "bg-primary")">
                                                @pt.DisplayName
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>@(item.ActionName ?? "—")</td>
                                <td class="text-end p-2 text-nowrap">
                                    <div class="row-action-groups">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Оперативні дії">
                                            <button class="btn btn-secondary"
                                                    title="Редагувати"
                                                    @onclick="() => OpenEdit(item.Id)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Критична дія">
                                            <button class="btn btn-danger"
                                                    title="Видалити"
                                                    @onclick="() => AskDeleteConfirmation(item.Id, item.ObservedDate)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_pagedResult.TotalPages > 1)
            {
                <nav class="pagination-strip">
                    <div class="pagination-summary">
                        Сторінка <strong>@_currentPage</strong> з <strong>@_pagedResult.TotalPages</strong>
                    </div>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!_pagedResult.HasPreviousPage ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPageAsync(_currentPage - 1)">‹</button>
                        </li>
                        @foreach (var page in GetVisiblePages())
                        {
                            if (page.HasValue)
                            {
                                var pageNum = page.Value;
                                <li class="page-item @(pageNum == _currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPageAsync(pageNum)">@pageNum</button>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }
                        <li class="page-item @(!_pagedResult.HasNextPage ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPageAsync(_currentPage + 1)">›</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>

</div>

<InterceptionFormDrawer @bind-IsOpen="_formOpen"
                        EditingId="_editingId"
                        OnSaved="LoadPageAsync" />

<InterceptionFilterDrawer @bind-IsOpen="_filterOpen"
                          Filter="_filter"
                          OnApplied="OnFilterApplied"
                          OnReset="OnFilterReset" />

<InterceptionImportDrawer @bind-IsOpen="_importOpen"
                          OnImported="LoadPageAsync" />

<InterceptionTextBlockDrawer @bind-IsOpen="_textBlockOpen"
                             Actions="_actions"
                             OnSaved="LoadPageAsync" />

@if (_deleteConfirmOpen && _pendingDeleteObservedDate is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="deleteObservationTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="deleteObservationTitle" class="modal-title">Підтвердження видалення</h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            disabled="@_deleteInProgress"
                            @onclick="CancelDeleteConfirmation"></button>
                </div>
                <div class="modal-body">
                    Ви дійсно хочете видалити запис від
                    <strong>@ConverterDateTimeExtensions.ToDisplay(_pendingDeleteObservedDate.Value).ToString("dd.MM.yy HH:mm")</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            disabled="@_deleteInProgress"
                            @onclick="CancelDeleteConfirmation">
                        Скасувати
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            disabled="@_deleteInProgress"
                            @onclick="ConfirmDeleteAsync">
                        @if (_deleteInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Видалити
                    </button>
                </div>
            </div>
        </div>
    </div>
}
