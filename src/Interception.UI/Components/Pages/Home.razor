@page "/"

<PageTitle>Головна</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0 text-black">Головна</h1>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Спостереження</strong>
            </div>
            <div class="card-body">
                <div class="text-muted mb-3">
                    Реєстр перехватів, перегляд деталей та імпорт.
                </div>
                <a class="btn btn-primary btn-sm" href="observations">Відкрити реєстр</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Припущення</strong>
            </div>
            <div class="card-body">
                <div class="text-muted mb-3">
                    Реєстр припущень (гипотез), перегляд деталей.
                </div>
                <a class="btn btn-primary btn-sm" href="analytics/clusters">Відкрити реєстр</a>
            </div>
        </div>
    </div>
</div>
