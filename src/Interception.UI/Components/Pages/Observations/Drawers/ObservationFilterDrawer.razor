@using Interception.UI.Components.Pages.Observations.Models
@using Interception.UI.Components.Shared.Drawer
@using Interception.UI.Domain.Enums

<Drawer @ref="_drawer"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        OnClosed="@HandleClosedAsync"
        Title="Фільтр спостережень"
        CloseOnBackdrop="true"
        CloseOnEscape="true">
    <ChildContent>
        <div class="d-flex flex-column gap-3">
            <div class="row g-2">
                <div class="col-12">
                    <label class="form-label small mb-1">Пошук</label>
                    <input class="form-control form-control-sm rounded-0"
                           @bind="_model.Query"
                           placeholder="Дія, людина, район, підрозділ" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1">Від</label>
                    <input type="datetime-local"
                           class="form-control form-control-sm rounded-0"
                           value="@FormatDateTimeLocal(_model.ObservedFrom)"
                           @onchange="OnObservedFromChanged" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1">До</label>
                    <input type="datetime-local"
                           class="form-control form-control-sm rounded-0"
                           value="@FormatDateTimeLocal(_model.ObservedTo)"
                           @onchange="OnObservedToChanged" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label small mb-1">Зв'язок підрозділу</label>
                    <InputSelect class="form-select form-select-sm rounded-0"
                                 @bind-Value="_model.SubdivisionStrength"
                                 TValue="SubdivisionLinkStrength?">
                        <option value="">Усі</option>
                        <option value="@SubdivisionLinkStrength.Weak">Слабкий</option>
                        <option value="@SubdivisionLinkStrength.Medium">Середній</option>
                        <option value="@SubdivisionLinkStrength.Strong">Сильний</option>
                    </InputSelect>
                </div>

                <div class="col-12 col-md-6">
                    <div class="border rounded-0 p-2 h-100 d-flex flex-column justify-content-center gap-2">
                        <div class="form-check mb-0">
                            <input id="onlyUnknownParticipantsFilter"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="_model.OnlyUnknownParticipants" />
                            <label class="form-check-label small" for="onlyUnknownParticipantsFilter">Лише НВ</label>
                        </div>

                        <div class="form-check mb-0">
                            <input id="onlyTypedActionFilter"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="_model.OnlyBoundAction" />
                            <label class="form-check-label small" for="onlyTypedActionFilter">Лише типізовані</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </ChildContent>

    <FooterContent>
        <div class="d-flex flex-wrap justify-content-end gap-2 w-100">
            <button type="button"
                    class="btn btn-outline-secondary btn-sm rounded-0"
                    @onclick="ResetAsync">
                Очистити
            </button>
            <button type="button"
                    class="btn btn-primary btn-sm rounded-0"
                    @onclick="ApplyAsync">
                Застосувати
            </button>
        </div>
    </FooterContent>
</Drawer>
