@using Interception.UI.Components.Pages.Observations.Models
@using Interception.UI.Components.Shared.Drawer
@using Interception.UI.Domain.Enums

<Drawer @ref="_drawer"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        OnClosed="@HandleDrawerClosedAsync"
        Title="Службовий р/о"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true">
    <ChildContent>
        <div class="d-flex flex-column gap-3" style="min-height: 0;">
            <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="fw-semibold">Вставка блоку</div>
                    <button type="button"
                            class="btn btn-outline-primary btn-sm rounded-0"
                            @onclick="ParseText"
                            disabled="@_saving">
                        Розібрати
                    </button>
                </div>

                <textarea class="form-control rounded-0 font-monospace"
                          rows="12"
                          @bind="_model.RawText"
                          placeholder="Вставте повний блок службового р/о..."></textarea>

                <div class="small text-muted">
                    Вставляйте шапку, дату, частоту, р/м, учасників і текст комунікації одним блоком.
                </div>
            </div>

            @if (_model.IsParsed)
            {
                <div class="border rounded-0 p-2 d-flex flex-column gap-3" style="min-height: 0;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="fw-semibold">Результат розбору</div>
                        @if (!string.IsNullOrWhiteSpace(_model.SourcePost))
                        {
                            <span class="badge text-bg-light rounded-0 border">Пост: @_model.SourcePost</span>
                        }
                    </div>

                    @if (_model.Warnings.Count > 0)
                    {
                        <div class="alert alert-warning rounded-0 py-2 px-3 mb-0">
                            <div class="fw-semibold mb-1">Перевірте поля</div>
                            <ul class="mb-0 ps-3 small">
                                @foreach (var warning in _model.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-12 col-lg-4">
                            <label class="form-label small mb-1">Дата і час</label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm rounded-0"
                                   @bind-value="_model.Draft.ObservedDate"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                        </div>

                        <div class="col-12 col-lg-8">
                            <label class="form-label small mb-1">Дія</label>
                            <div class="input-group input-group-sm">
                                <input class="form-control rounded-0"
                                       @bind="_model.Draft.ActionRaw"
                                       placeholder="Наприклад: службовий р/о" />
                                <button type="button"
                                        class="btn btn-outline-secondary rounded-0"
                                        @onclick="ApplySuggestedAction"
                                        disabled="@string.IsNullOrWhiteSpace(_model.SuggestedActionRaw)">
                                    Підставити
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_model.SuggestedActionRaw))
                            {
                                <div class="form-text mt-1">Порада: <span class="fw-semibold">@_model.SuggestedActionRaw</span></div>
                            }
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="fw-semibold">Типізована дія</div>
                            @if (_model.Draft.ObservationActionId is not null)
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm rounded-0"
                                        @onclick="ClearBoundAction">
                                    Очистити
                                </button>
                            }
                        </div>

                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-lg-8">
                                <label class="form-label small mb-1">Пошук дії</label>
                                <input class="form-control form-control-sm rounded-0"
                                       @bind="_actionSearch"
                                       @bind:event="oninput"
                                       placeholder="Шукати у каталозі" />
                            </div>
                            <div class="col-12 col-lg-4">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm rounded-0 w-100"
                                        @onclick="SearchActionsAsync">
                                    Знайти
                                </button>
                            </div>
                        </div>

                        @if (_actionSuggestions.Count > 0)
                        {
                            <div class="list-group" style="max-height: 12rem; overflow: auto;">
                                @foreach (var item in _actionSuggestions)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action rounded-0"
                                            @onclick="() => SelectBoundAction(item)">
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="small text-muted">@item.Category</div>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small mb-1">Шар / частота</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Draft.Layer" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-8">
                            <label class="form-label small mb-1">Р/М</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Draft.RmRaw" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Район</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Draft.DistrictRaw" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Локація</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Draft.LocationRaw" />
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="fw-semibold">Учасники</div>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm rounded-0"
                                    @onclick="AddParticipantRow">
                                Додати
                            </button>
                        </div>

                        <div class="table-responsive" style="max-height: 16rem; overflow: auto;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 40%;">Позначення</th>
                                        <th style="width: 30%;">Роль</th>
                                        <th style="width: 10%;">НВ</th>
                                        <th style="width: 10%;">№</th>
                                        <th style="width: 10%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_model.Draft.Participants.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-muted">Учасників не знайдено</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _model.Draft.Participants.OrderBy(x => x.Ordinal))
                                        {
                                            <tr>
                                                <td>
                                                    <input class="form-control form-control-sm rounded-0" @bind="row.LabelRaw" />
                                                </td>
                                                <td>
                                                    <input class="form-control form-control-sm rounded-0" @bind="row.RoleRaw" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="row.IsUnknown" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm rounded-0" @bind="row.Ordinal" />
                                                </td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-sm rounded-0"
                                                            @onclick="() => RemoveParticipant(row)">
                                                        ×
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="fw-semibold">Запропоновані мітки</div>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm rounded-0"
                                    @onclick="AddTagRow">
                                Додати мітку
                            </button>
                        </div>

                        @if (_model.SuggestedTags.Count == 0)
                        {
                            <div class="small text-muted">Автоматичних міток немає.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in _model.SuggestedTags)
                                {
                                    <button type="button"
                                            class="btn @(tag.Applied ? "btn-success" : "btn-outline-secondary") btn-sm rounded-0"
                                            @onclick="() => ApplySuggestedTag(tag)">
                                        @tag.Value
                                        <span class="ms-1 text-muted">(@GetTagKindText(tag.Kind))</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="table-responsive" style="max-height: 12rem; overflow: auto;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 52%;">Мітка</th>
                                        <th style="width: 28%;">Тип</th>
                                        <th style="width: 10%;">Джерело</th>
                                        <th style="width: 10%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_model.Draft.Tags.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-muted">Міток немає</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _model.Draft.Tags)
                                        {
                                            <tr>
                                                <td>
                                                    <input class="form-control form-control-sm rounded-0" @bind="row.RawValue" />
                                                </td>
                                                <td>
                                                    <InputSelect class="form-select form-select-sm rounded-0"
                                                                 @bind-Value="row.Kind"
                                                                 TValue="TagKind">
                                                        <option value="@TagKind.Keyword">Ключове</option>
                                                        <option value="@TagKind.Person">Людина</option>
                                                        <option value="@TagKind.Location">Місце</option>
                                                        <option value="@TagKind.Subdivision">Підрозділ</option>
                                                        <option value="@TagKind.Callsign">Позивний</option>
                                                        <option value="@TagKind.Other">Інше</option>
                                                    </InputSelect>
                                                </td>
                                                <td>
                                                    <InputSelect class="form-select form-select-sm rounded-0"
                                                                 @bind-Value="row.Source"
                                                                 TValue="ObservationTagSource">
                                                        <option value="@ObservationTagSource.Manual">Вручну</option>
                                                        <option value="@ObservationTagSource.Derived">Похідне</option>
                                                        <option value="@ObservationTagSource.Import">Імпорт</option>
                                                    </InputSelect>
                                                </td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-sm rounded-0"
                                                            @onclick="() => RemoveTag(row)">
                                                        ×
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <label class="form-label small mb-1">Примітки</label>
                        <textarea class="form-control rounded-0 font-monospace"
                                  rows="10"
                                  @bind="_model.Draft.Note"
                                  placeholder="Текст комунікації"></textarea>
                    </div>
                </div>
            }
        </div>
    </ChildContent>

    <FooterContent>
        <div class="d-flex flex-wrap justify-content-end gap-2">
            <button type="button"
                    class="btn btn-outline-secondary rounded-0"
                    @onclick="CloseDrawerAsync"
                    disabled="@_saving">
                Закрити
            </button>
            <button type="button"
                    class="btn btn-primary rounded-0"
                    @onclick="ParseText"
                    disabled="@_saving">
                Розібрати
            </button>
            <button type="button"
                    class="btn btn-success rounded-0"
                    @onclick="SaveAsync"
                    disabled="@(_saving || !_model.IsParsed)">
                Зберегти
            </button>
        </div>
    </FooterContent>
</Drawer>
