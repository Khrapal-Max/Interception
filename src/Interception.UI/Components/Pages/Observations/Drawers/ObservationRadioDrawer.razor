@using Interception.UI.Components.Pages.Observations.Models
@using Interception.UI.Components.Shared.Drawer

<Drawer @ref="_drawer"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        OnClosed="@HandleDrawerClosedAsync"
        Title="Службовий р/о"
        DisableClose="@_transferring"
        CloseOnBackdrop="true"
        CloseOnEscape="true">
    <ChildContent>
        <div class="d-flex flex-column gap-3" style="min-height: 0;">
            <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="fw-semibold">Вставка блоку</div>
                    <button type="button"
                            class="btn btn-outline-primary btn-sm rounded-0"
                            @onclick="ParseText"
                            disabled="@_transferring">
                        Розібрати
                    </button>
                </div>

                <textarea class="form-control rounded-0 font-monospace"
                          rows="12"
                          @bind="_model.RawText"
                          placeholder="Вставте повний блок службового р/о..."></textarea>

                <div class="small text-muted">
                    Блок розбирається у чернетку, після чого передається в основну форму створення спостереження.
                </div>
            </div>

            @if (_model.IsParsed)
            {
                <div class="alert alert-info rounded-0 py-2 px-3 mb-0">
                    <div class="fw-semibold mb-1">Що далі</div>
                    <div class="small">
                        Тут формується чернетка. Після кнопки <span class="fw-semibold">Передати у форму</span>
                        відкриється основний drawer створення, де оператор перевірить поля, дію, теги та відомих учасників.
                    </div>
                </div>

                <div class="border rounded-0 p-2 d-flex flex-column gap-3" style="min-height: 0;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="fw-semibold">Результат розбору</div>
                        @if (!string.IsNullOrWhiteSpace(_model.SourcePost))
                        {
                            <span class="badge text-bg-light rounded-0 border">Пост: @_model.SourcePost</span>
                        }
                    </div>

                    @if (_model.Warnings.Count > 0)
                    {
                        <div class="alert alert-warning rounded-0 py-2 px-3 mb-0">
                            <div class="fw-semibold mb-1">Перевірте поля</div>
                            <ul class="mb-0 ps-3 small">
                                @foreach (var warning in _model.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-12 col-lg-4">
                            <label class="form-label small mb-1">Дата і час</label>
                            <input type="datetime-local"
                                   class="form-control form-control-sm rounded-0"
                                   @bind-value="_model.Seed.ObservedDate"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                        </div>

                        <div class="col-12 col-lg-8">
                            <label class="form-label small mb-1">Дія</label>
                            <div class="input-group input-group-sm">
                                <input class="form-control rounded-0"
                                       @bind="_model.Seed.ActionRaw"
                                       placeholder="Наприклад: службовий р/о" />
                                <button type="button"
                                        class="btn btn-outline-secondary rounded-0"
                                        @onclick="ApplySuggestedAction"
                                        disabled="@string.IsNullOrWhiteSpace(_model.SuggestedActionRaw)">
                                    Підставити
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_model.SuggestedActionRaw))
                            {
                                <div class="small text-muted mt-1">Підказка: @_model.SuggestedActionRaw</div>
                            }
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center">
                            <div class="fw-semibold">Типізована дія</div>
                            @if (_model.Seed.ObservationActionId is not null)
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm rounded-0"
                                        @onclick="ClearBoundAction">
                                    Очистити
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_model.Seed.ObservationActionName))
                        {
                            <div class="small">Обрано: <span class="fw-semibold">@_model.Seed.ObservationActionName</span></div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-lg-8">
                                <label class="form-label small mb-1">Пошук дії</label>
                                <input class="form-control form-control-sm rounded-0"
                                       @bind="_actionSearch"
                                       @bind:event="oninput"
                                       placeholder="Назва дії" />
                            </div>
                            <div class="col-12 col-lg-4">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm rounded-0 w-100"
                                        @onclick="SearchActionsAsync">
                                    Знайти
                                </button>
                            </div>
                        </div>

                        @if (_actionSuggestions.Count > 0)
                        {
                            <div class="list-group" style="max-height: 12rem; overflow: auto;">
                                @foreach (var item in _actionSuggestions)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action rounded-0"
                                            @onclick="() => SelectBoundAction(item)">
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="small text-muted">@item.Category</div>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Шар</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Seed.Layer" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Р/М</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Seed.RmRaw" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Район</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Seed.DistrictRaw" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Підрозділ</label>
                            <input class="form-control form-control-sm rounded-0" @bind="_model.Seed.SubdivisionRaw" />
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="fw-semibold">Учасники</div>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-0" @onclick="AddParticipantRow">Додати</button>
                        </div>

                        <div class="table-responsive" style="max-height: 12rem;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 44%;">Позначення</th>
                                        <th style="width: 28%;">Роль</th>
                                        <th style="width: 12%;">НВ</th>
                                        <th style="width: 8%;">№</th>
                                        <th style="width: 8%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_model.Seed.Participants.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted">Немає учасників</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _model.Seed.Participants.OrderBy(x => x.Ordinal))
                                        {
                                            <tr>
                                                <td><input class="form-control form-control-sm rounded-0" @bind="row.LabelRaw" /></td>
                                                <td><input class="form-control form-control-sm rounded-0" @bind="row.RoleRaw" /></td>
                                                <td class="text-center"><input type="checkbox" class="form-check-input" @bind="row.IsUnknown" /></td>
                                                <td><input type="number" class="form-control form-control-sm rounded-0" min="1" @bind="row.Ordinal" /></td>
                                                <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm rounded-0" @onclick="() => RemoveParticipant(row)">×</button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="border rounded-0 p-2 d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="fw-semibold">Мітки</div>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-0" @onclick="AddTagRow">Додати мітку</button>
                        </div>

                        @if (_model.SuggestedTags.Count > 0)
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var item in _model.SuggestedTags)
                                {
                                    <div class="border rounded-0 p-2 d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@item.Value</div>
                                            <div class="small text-muted">@GetTagKindText(item.Kind) @(string.IsNullOrWhiteSpace(item.Reason) ? string.Empty : $"· {item.Reason}")</div>
                                        </div>
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm rounded-0"
                                                @onclick="() => ApplySuggestedTag(item)"
                                                disabled="@item.Applied">
                                            @(item.Applied ? "Додано" : "Додати")
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="table-responsive" style="max-height: 12rem;">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 55%;">Значення</th>
                                        <th style="width: 20%;">Тип</th>
                                        <th style="width: 15%;">Джерело</th>
                                        <th style="width: 10%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_model.Seed.Tags.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-muted">Немає міток</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _model.Seed.Tags)
                                        {
                                            <tr>
                                                <td><input class="form-control form-control-sm rounded-0" @bind="row.RawValue" /></td>
                                                <td><div class="small">@GetTagKindText(row.Kind)</div></td>
                                                <td><div class="small">@row.Source</div></td>
                                                <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm rounded-0" @onclick="() => RemoveTag(row)">×</button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <label class="form-label small mb-1">Примітка</label>
                        <textarea class="form-control form-control-sm rounded-0"
                                  rows="8"
                                  @bind="_model.Seed.Note"></textarea>
                    </div>
                </div>
            }
        </div>
    </ChildContent>

    <FooterContent>
        <div class="d-flex flex-wrap justify-content-end gap-2 w-100">
            <button type="button"
                    class="btn btn-outline-secondary btn-sm rounded-0"
                    @onclick="CloseDrawerAsync"
                    disabled="@_transferring">
                Закрити
            </button>
            <button type="button"
                    class="btn btn-primary btn-sm rounded-0"
                    @onclick="TransferToCreateAsync"
                    disabled="@(!_model.IsParsed || _transferring)">
                Передати у форму
            </button>
        </div>
    </FooterContent>
</Drawer>
