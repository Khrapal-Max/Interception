@using Interception.UI.Application.Observations.Abstractions
@using Interception.UI.Application.Observations.Dtos
@using Interception.UI.Components.Shared.Drawer


<Drawer IsOpen="IsOpen"
        IsOpenChanged="OnIsOpenChanged"
        Title="Створити"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        FooterContent="CreateFooter">

    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label">Дата</label>
            <InputDate @bind-Value="_date" class="form-control" />
        </div>

        <div class="col-12 col-md-4">
            <label class="form-label">Частина доби</label>
            <select class="form-select" @bind="_dayPart">
                <option value="1">AM</option>
                <option value="2">PM</option>
            </select>
        </div>

        <div class="col-12 col-md-4">
            <label class="form-label">Шар</label>
            <input class="form-control" type="text" @bind="_layer" @bind:event="oninput" placeholder="..." />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Р/М</label>
            <input class="form-control" @bind="_rmRaw" @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Точка</label>
            <input class="form-control" @bind="_pointRaw" @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Локація</label>
            <input class="form-control" @bind="_locationRaw" @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Район</label>
            <input class="form-control" @bind="_districtRaw" @bind:event="oninput" />
        </div>

        <div class="col-12">
            <label class="form-label">Дія *</label>
            <input class="form-control" @bind="_actionRaw" @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Примітка</label>
            <input class="form-control" @bind="_note" @bind:event="oninput" />
        </div>
    </div>

    <hr />

    <div class="d-flex align-items-center justify-content-between">
        <strong>Учасники</strong>
        <button class="btn btn-sm btn-outline-primary rounded-0" @onclick="AddParticipant" disabled="@_saving">
            + Додати
        </button>
    </div>

    <div class="table-responsive mt-2">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 36%;">Позивний</th>
                    <th style="width: 14%;">НВ</th>
                    <th style="width: 40%;">Роль</th>
                    <th style="width: 10%;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_participants.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">—</td></tr>
                }
                else
                {
                    @for (var i = 0; i < _participants.Count; i++)
                    {
                        var p = _participants[i];
                        var index = i;
                        <tr @key="p">
                            <td>
                                <input class="form-control form-control-sm" @bind="p.LabelRaw" @bind:event="oninput" placeholder="КЛИМ / НВ" />
                            </td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" @bind="p.IsUnknown" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="p.RoleRaw" @bind:event="oninput" placeholder="..." />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger rounded-0" @onclick="() => RemoveParticipant(index)" disabled="@_saving">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mt-2">@_error</div>
    }
    @if (_duplicate)
    {
        <div class="alert alert-warning mt-2">Дублікат: такий запис вже існує (ContentHash).</div>
    }
</Drawer>

@code {
    private RenderFragment CreateFooter => @<div>
        <button class="btn btn-success rounded-0" @onclick="SaveAsync" disabled="@_saving">Save</button>
        <button class="btn btn-outline-secondary rounded-0" @onclick="OnClose" disabled="@_saving">Close</button>
    </div>;

    private async Task OnIsOpenChanged(bool value)
    {
        if (!value && OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}