@page "/observations/create"

<PageTitle>Запис спостиреження</PageTitle>

<div class="observation-create-page container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-1">
        <div class="text-black">Запис спостиреження</div>

        <div class="d-flex flex-wrap">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-0" @onclick="CancelAsync" disabled="@_saving">
                До реєстру
            </button>
            <button type="button" class="btn btn-success btn-sm rounded-0" @onclick="SaveAsync" disabled="@_saving">
                Зберегти
            </button>
        </div>
    </div>

    @if (_duplicate)
    {
        <div class="alert alert-warning py-2 px-3 mb-2 rounded-0">Дублікат: такий запис вже існує.</div>
    }

    <div class="row align-items-start">
        <div class="col-12 col-xxl-9">
            <div class="card shadow-sm rounded-0">
                <div class="card-header py-2">Основні дані</div>
                <div class="card-body py-2">
                    <div class="row g-1">
                        <div class="col-6 col-lg-2">
                            <label class="form-label small mb-1">Дата</label>
                            <InputDate @bind-Value="_date" class="form-control rounded-0 form-control-sm" />
                        </div>

                        <div class="col-6 col-lg-1">
                            <label class="form-label small mb-1">ЧС</label>
                            <select class="form-select rounded-0 form-select-sm" @bind="_dayPart">
                                <option value="1">AM</option>
                                <option value="2">PM</option>
                            </select>
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label small mb-1">Шар</label>
                            <div class="position-relative">
                                <input class="form-control rounded-0 form-control-sm"
                                       @bind="_layer"
                                       @bind:event="oninput"
                                       @bind:after="OnLayerInputAsync"
                                       @onfocus="OnLayerFocus"
                                       @onblur="OnLayerBlurAsync"
                                       @onkeydown="OnLayerKeyDown"
                                       autocomplete="off" />

                                @if (ShowLayerSuggestions)
                                {
                                    <div class="dropdown-menu show w-100 shadow-sm rounded-0 create-page-dropdown">
                                        @foreach (var s in _layerSuggestions)
                                        {
                                            <button type="button"
                                                    class="dropdown-item"
                                                    @onmousedown="() => SelectLayerSuggestion(s)"
                                                    @onmousedown:preventDefault="true">
                                                <div class="d-flex justify-content-between gap-2">
                                                    <span class="text-truncate">@s.Layer</span>
                                                    <span class="text-muted text-truncate">@s.RmRaw</span>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label small mb-1">Р/М</label>
                            <input class="form-control rounded-0 form-control-sm" @bind="_rmRaw" @bind:event="oninput" />
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label small mb-1">Район</label>
                            <div class="position-relative">
                                <input class="form-control rounded-0 form-control-sm"
                                       @bind="_districtRaw"
                                       @bind:event="oninput"
                                       @bind:after="OnDistrictInputAsync"
                                       @onfocus="OnDistrictFocus"
                                       @onblur="OnDistrictBlurAsync"
                                       @onkeydown="OnDistrictKeyDown"
                                       autocomplete="off" />

                                @if (ShowDistrictSuggestions)
                                {
                                    <div class="dropdown-menu show w-100 shadow-sm rounded-0 create-page-dropdown">
                                        @foreach (var value in _districtSuggestions)
                                        {
                                            <button type="button"
                                                    class="dropdown-item"
                                                    @onmousedown="() => SelectDistrictSuggestion(value)"
                                                    @onmousedown:preventDefault="true">
                                                @value
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label small mb-1">Точка</label>
                            <input class="form-control rounded-0 form-control-sm" @bind="_pointRaw" @bind:event="oninput" />
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label small mb-1">Локація</label>
                            <input class="form-control rounded-0 form-control-sm" @bind="_locationRaw" @bind:event="oninput" />
                        </div>                       

                        <div class="col-12 col-lg-6">
                            <label class="form-label small mb-1">Дія *</label>
                            <input class="form-control rounded-0 form-control-sm"
                                   @bind="_actionRaw"
                                   @bind:event="oninput"
                                   @bind:after="OnActionInputAsync" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small mb-1">Примітка</label>
                            <input class="form-control rounded-0 form-control-sm" @bind="_note" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm rounded-0">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <span>Учасники зв'язку</span>
                        <span class="badge text-bg-light border rounded-2 mx-2">Максимум 3</span>
                    </div>

                    <button type="button"
                            class="btn btn-primary btn-sm rounded-0"
                            @onclick="AddParticipant"
                            disabled="@(_saving || !CanAddParticipant)">
                        + Додати
                    </button>
                </div>

                <div class="card-body py-2">
                    <div class="alert alert-light border rounded-0 py-2 px-2 small">
                        <strong>НВ</strong> — особа невідома. Можна залишити позначення порожнім або вказати тимчасовий ярлик: <code>НВ 1</code>, <code>НВ 2</code>, <code>водій</code>.
                    </div>

                    @if (_participants.Count == 0)
                    {
                        <div class="text-muted small">Додай учасника або збережи запис без учасників.</div>
                    }
                    else
                    {
                        @for (var i = 0; i < _participants.Count; i++)
                        {
                            var p = _participants[i];
                            var index = i;

                            <div class="border rounded-0 p-2 @(i < _participants.Count - 1 ? "mb-1" : "")" @key="p">
                                <div class="row g-1 align-items-end">
                                    <div class="col-12 col-xl-5">
                                        <label class="form-label small mb-1">@(p.IsUnknown ? "Тимчасове позначення" : "Особа / позивний")</label>
                                        <div class="position-relative">
                                            <input class="form-control rounded-0 form-control-sm"
                                                   @bind="p.LabelRaw"
                                                   @bind:event="oninput"
                                                   @bind:after="() => OnParticipantInputAsync(index)"
                                                   @onfocus="() => OnParticipantFocus(index)"
                                                   @onblur="OnParticipantBlurAsync"
                                                   @onkeydown="OnParticipantKeyDown"
                                                   placeholder="@(p.IsUnknown ? "НВ 1 / опис" : "КЛИМ / ПЕТРО")"
                                                   autocomplete="off" />

                                            @if (ShowParticipantSuggestions(index))
                                            {
                                                <div class="dropdown-menu show w-100 shadow-sm rounded-0 create-page-dropdown">
                                                    @foreach (var s in _participantSuggestions)
                                                    {
                                                        <button type="button"
                                                                class="dropdown-item"
                                                                @onmousedown="() => SelectParticipantSuggestion(index, s)"
                                                                @onmousedown:preventDefault="true">
                                                            <div class="d-flex justify-content-between gap-2">
                                                                <span class="text-truncate">@s.Display</span>
                                                                <span class="text-muted small text-nowrap">@(s.LastSeenDate?.ToString("dd.MM") ?? "—")</span>
                                                            </div>
                                                            <div class="small text-muted text-truncate">@s.Subtitle</div>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-12 col-xl-3">
                                        <label class="form-label small mb-1">Роль</label>
                                        <input class="form-control rounded-0 form-control-sm"
                                               @bind="p.RoleRaw"
                                               @bind:event="oninput"
                                               placeholder="водій / оператор" />
                                    </div>

                                    <div class="col-6 col-xl-2">
                                        <label class="form-label small d-block">Статус</label>
                                        @if (string.IsNullOrWhiteSpace(p.StatusText))
                                        {
                                            <div class="badge text-bg-light border rounded-0 w-100 text-start">Новий запис</div>
                                        }
                                        else
                                        {
                                            <div class="badge text-bg-secondary rounded-0 w-100 text-start">@p.StatusText</div>
                                        }
                                    </div>

                                    <div class="col-6 col-xl-2">
                                        <label class="form-label small mb-1 d-block">НВ / дії</label>
                                        <div class="d-flex align-items-center justify-content-between gap-1">
                                            <div class="form-check form-switch mx-2">
                                                <input class="form-check-input" type="checkbox" @bind="p.IsUnknown" />
                                            </div>
                                            <button type="button"
                                                    class="btn btn-danger btn-sm rounded-0 px-2"
                                                    @onclick="() => RemoveParticipant(index)"
                                                    disabled="@_saving">
                                                ✕
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xxl-3">
            <div class="card shadow-sm rounded-0 border-secondary-subtle">
                <div class="card-header py-2 d-flex align-items-center justify-content-between gap-2">
                    <span>Відомий контекст дій</span>
                </div>

                <div class="card-body py-2 overflow-auto" style="max-height: calc(100vh - 14rem); min-height: 18rem;">
                    @if (_contextLoading)
                    {
                        <div class="small">Оновлення контексту…</div>
                    }
                    else if (_actionContext.Count == 0)
                    {
                        <div class="small">Оберіть дію та хоча б одну визначену особу, щоб побачити пов'язані вузли.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush rounded-0">
                            @foreach (var item in _actionContext)
                            {
                                <div class="list-group-item px-0 py-2">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong class="text-break">@item.Display</strong>
                                        <span class="badge rounded-0 @GetContextBadgeClass(item.RelationType)">@item.RelationType</span>
                                    </div>

                                    <div class="small mt-1">@item.Description</div>

                                    <div class="small mt-1">
                                        Вага: @item.Weight · Остання дата: @(item.LastSeenDate?.ToString("dd.MM.yyyy") ?? "—")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
