@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-0">Деталі спостереження</h5>
                        @if (_dto is not null)
                        {
                            <div class="small text-muted">
                                @_dto.ObservedDate.ToString("dd.MM.yyyy")
                                · @(_dto.DayPart == 2 ? "PM" : "AM")
                            </div>
                        }
                    </div>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseAsync"
                            disabled="@_loading">
                    </button>
                </div>

                <div class="modal-body">
                    @if (_loading)
                    {
                        <div class="p-3 text-muted">Завантаження…</div>
                    }
                    else if (_dto is null)
                    {
                        <div class="p-3 text-muted">Дані не знайдено.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            <div class="border rounded-0 p-3">
                                <div class="row g-2 small">
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Дата</div>
                                        <div>@_dto.ObservedDate.ToString("dd.MM.yyyy")</div>
                                    </div>
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Частина доби</div>
                                        <div>@(_dto.DayPart == 2 ? "PM" : "AM")</div>
                                    </div>
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Шар</div>
                                        <div>@(_dto.Layer ?? "—")</div>
                                    </div>
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Р/М</div>
                                        <div>@(_dto.RmRaw ?? "—")</div>
                                    </div>                        
                                   
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Точка</div>
                                        <div>@(_dto.PointRaw ?? "—")</div>
                                    </div>
                                    <div class="col-12 col-md-3 border">
                                        <div class="text-muted">Локація</div>
                                        <div>@(_dto.LocationRaw ?? "—")</div>
                                    </div>

                                    <div class="col-12 col-md-6 border">
                                        <div class="text-muted">Вектор сигналу</div>
                                        <div>@(_dto.DistrictRaw ?? "—")</div>
                                    </div>

                                    <div class="col-12 col-md-6 border">
                                        <div class="text-muted">Дія</div>
                                        <div class="fw-semibold">@_dto.ActionRaw</div>
                                    </div>

                                    <div class="col-12 col-md-6 border">
                                        <div class="text-muted">Примітка</div>
                                        <div>@(_dto.Note ?? "—")</div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-0">
                                <div class="p-2 border-bottom fw-semibold">Учасники</div>

                                @if (_dto.Participants.Count == 0)
                                {
                                    <div class="p-3 text-muted small">Учасники відсутні.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Особа</th>
                                                    <th>Роль</th>
                                                    <th>Припущення особи</th>
                                                    <th>Припущення ролі</th>
                                                    <th>Факт особи</th>
                                                    <th>Факт ролі</th>
                                                    <th class="text-center">Дії</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in _dto.Participants.OrderBy(x => x.Ordinal))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="fw-semibold">
                                                                @(string.IsNullOrWhiteSpace(p.LabelRaw) ? $"НВ {p.Ordinal}" : p.LabelRaw) 
                                                            </div>
                                                        </td>
                                                        <td>@(p.RoleRaw ?? "—")</td>
                                                        <td>@(p.EffectiveDisplayName ?? "—")</td>
                                                        <td>@(p.HypothesisRole ?? "—")</td>
                                                        <td>@(p.ResolvedActorDisplayName ?? "—")</td>
                                                        <td>@(p.ConfirmedRole ?? "—")</td>
                                                        <td class="text-center">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-primary rounded-0"
                                                                    disabled="@(p.UnknownClusterId == Guid.Empty)"
                                                                    @onclick="() => OpenClusterAnalyticsAsync(p.UnknownClusterId)">
                                                                Припущення
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-success rounded-0"
                                                                    @onclick="() => OpenParticipantAnalyticsAsync(p.Id)">
                                                                Ідентифікувати
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="small text-muted">
                                Source: @_dto.Source · Row: @(_dto.SourceRow?.ToString() ?? "—")
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary rounded-0"
                            @onclick="CloseAsync"
                            disabled="@_loading">
                        Закрити
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}