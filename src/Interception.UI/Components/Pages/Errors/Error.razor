@page "/Error"
@using System.Diagnostics

<PageTitle>Помилка</PageTitle>

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 text-danger mb-2">Помилка</h1>
        <div class="text-muted mb-3">
            Під час обробки запиту сталася помилка.
        </div>

        @if (ShowRequestId)
        {
            <div class="mb-3">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </div>
        }

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="">На головну</a>
            <a class="btn btn-primary btn-sm" href="observations">Спостереження</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
