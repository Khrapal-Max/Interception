@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Components.Shared.Drawer

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="Редагування особи"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        <div class="row g-2">

            <div class="col-12">
                <label class="form-label form-label-sm">
                    Позивний <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control form-control-sm @(_nameError ? "is-invalid" : "")"
                       placeholder="напр. ШАПКА"
                       value="@_name"
                       @oninput="e => { _name = e.Value?.ToString(); _nameError = false; }" />
                @if (_nameError)
                {
                    <div class="invalid-feedback">Позивний обов'язковий</div>
                }
            </div>

            <div class="col-4">
                <label class="form-label form-label-sm">Частота</label>
                <input type="text" class="form-control form-control-sm"
                       placeholder="напр. 402.0000"
                       value="@_frequency"
                       @oninput="e => _frequency = e.Value?.ToString()" />
            </div>

            <div class="col-4">
                <label class="form-label form-label-sm">Роль</label>
                <input type="text" class="form-control form-control-sm"
                       placeholder="напр. оператор бпла"
                       value="@_role"
                       @oninput="e => _role = e.Value?.ToString()" />
            </div>

            <div class="col-4">
                <label class="form-label form-label-sm">Підрозділ</label>
                <input type="text" class="form-control form-control-sm"
                       placeholder="напр. 1 мсб 656 мсп"
                       value="@_division"
                       @oninput="e => _division = e.Value?.ToString()" />
            </div>

            @if (Participant is not null && !Participant.IsConfirmed)
            {
                <div class="col-12">
                    <div class="alert alert-secondary py-2 px-3 small mb-0">
                        Якщо вкажете той самий позивний, частоту і підрозділ, рядок буде зведено до вже існуючої канонічної особи.
                    </div>
                </div>
            }

            @if (_serverError is not null)
            {
                <div class="col-12">
                    <div class="alert alert-danger py-2 px-3 small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>@_serverError
                    </div>
                </div>
            }

        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm"
                @onclick="CloseAsync"
                disabled="@_saving">
            Скасувати
        </button>
        <button class="btn btn-success btn-sm"
                @onclick="SaveAsync"
                disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Зберегти
        </button>
    </FooterContent>
</Drawer>
