
<Drawer IsOpen="@IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="@(EditingRole is null ? "Нова роль" : "Редагування ролі")"
        DisableClose="@_saving"
        CloseOnBackdrop="true"
        CloseOnEscape="true"
        OnClosed="OnDrawerClosed">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label form-label-sm">
                    Назва <span class="text-danger">*</span>
                </label>
                <input type="text"
                       class="form-control @(_nameError ? "is-invalid" : "")"
                       placeholder="напр. командир взводу"
                       value="@_name"
                       @oninput="e => { _name = e.Value?.ToString(); _nameError = false; }"
                       maxlength="200" />
                @if (_nameError)
                {
                    <div class="invalid-feedback">Назва обов'язкова</div>
                }
                <div class="form-text text-muted">@(_name?.Length ?? 0) / 200</div>
            </div>

            <div class="col-12">
                <label class="form-label form-label-sm">Опис</label>
                <textarea class="form-control form-control-sm"
                          rows="3"
                          placeholder="Короткий опис ролі..."
                          value="@_description"
                          @oninput="e => _description = e.Value?.ToString()"
                          maxlength="500"></textarea>
                <div class="form-text text-muted">@(_description?.Length ?? 0) / 500</div>
            </div>

            @if (_serverError is not null)
            {
                <div class="col-12">
                    <div class="alert alert-danger py-2 px-3 mb-0 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>@_serverError
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-sm" @onclick="CloseAsync" disabled="@_saving">Скасувати</button>
        <button class="btn btn-success btn-sm" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Зберегти
        </button>
    </FooterContent>
</Drawer>
