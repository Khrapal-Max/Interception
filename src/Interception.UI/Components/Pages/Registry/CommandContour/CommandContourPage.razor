@page "/registries/directive-relations"
@using Interception.UI.Application.Interceptions.Dtos
@using Interception.UI.Application.Registry.Dtos
@using Interception.UI.Components.Pages.Registry.Toolbar
@using Interception.UI.Extensions

<PageTitle>Регістри — Контур керування</PageTitle>

<div class="page-shell">
    <RegistriesToolbar ActiveSection="directive-relations">
        <MetaContent>
            <span>Зв'язків: <strong>@_rows.Count</strong></span>
            <span>Варіантів осіб: <strong>@_options.Count</strong></span>
        </MetaContent>
        <ActionsContent>
            <button class="btn btn-success btn-sm rounded-0"
                    @onclick="LoadAsync"
                    disabled="@_loading">
                ⟳
            </button>
        </ActionsContent>
    </RegistriesToolbar>

    <div class="page-panel h-100 directive-page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження…
                </div>
            </div>
        }
        else
        {
            <div class="row g-0 h-100 directive-page-row">
                <div class="col-12 col-xxl-4 border-end d-flex flex-column min-h-0 directive-left-pane">
                    <div class="pane-head px-3 py-3 border-bottom flex-shrink-0">
                        <h5 class="mb-1">Новий зв'язок керування</h5>
                        <div class="small text-muted">Тут можна вибрати як канонічну особу, так і окремий підтверджений рядок, якщо canonical ще не створена.</div>
                    </div>

                    <div class="panel-scroll px-3 py-3 d-flex flex-column gap-3 command-contour-form-scroll">
                        <div>
                            <label class="form-label">Хто керує</label>
                            <select class="form-select rounded-0"
                                    value="@_fromSelection"
                                    @onchange="OnFromSelectionChanged">
                                <option value="">— оберіть особу —</option>
                                @foreach (var option in _options)
                                {
                                    <option value="@BuildOptionValue(option)">@BuildOptionLabel(option)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Ким керує</label>
                            <select class="form-select rounded-0"
                                    value="@_toSelection"
                                    @onchange="OnToSelectionChanged">
                                <option value="">— оберіть особу —</option>
                                @foreach (var option in _options)
                                {
                                    <option value="@BuildOptionValue(option)">@BuildOptionLabel(option)</option>
                                }
                            </select>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-lg-6 col-xxl-12">
                                <label class="form-label">Тип зв'язку</label>
                                <select class="form-select rounded-0" @bind="_form.RelationType">
                                    @foreach (var relationType in Enum.GetValues<CommandContourRelationTypeDto>())
                                    {
                                        <option value="@relationType">@BuildRelationTypeLabel(relationType)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-lg-6 col-xxl-12">
                                <label class="form-label">Впевненість</label>
                                <select class="form-select rounded-0" @bind="_form.Confidence">
                                    @foreach (var confidence in Enum.GetValues<CommandContourConfidenceDto>())
                                    {
                                        <option value="@confidence">@BuildConfidenceLabel(confidence)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="form-label">Коментар</label>
                            <textarea class="form-control rounded-0"
                                      rows="5"
                                      @bind="_form.Comment"
                                      placeholder="Коротко: чому це вважається структурним керуванням"></textarea>
                        </div>
                    </div>

                    <div class="directive-actions px-3 py-2 border-top">
                        <div class="d-flex justify-content-end">
                            <button class="btn btn-success btn-sm rounded-0"
                                    @onclick="SaveAsync"
                                    disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <span class="me-1">💾</span>
                                }
                                Зберегти
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xxl-8 d-flex flex-column min-h-0 directive-right-pane">
                    <div class="pane-head px-3 py-3 border-bottom flex-shrink-0">
                        <h5 class="mb-1">Поточний контур керування</h5>
                        <div class="small text-muted">Explicit-зв'язки між канонічними особами та поодинокими підтвердженими особами.</div>
                    </div>

                    @if (_rows.Count == 0)
                    {
                        <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                            <div class="text-center py-5">
                                <div class="fs-1 d-block mb-2 opacity-25">⇄</div>
                                <div>Зв'язків керування ще немає</div>
                                <div class="small mt-1">Створіть перший ручний structural link ліворуч.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="panel-scroll p-0 directive-table-scroll">
                            <div class="table-wrap h-100">
                                <table class="table table-hover table-sm align-middle data-table mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 26%">Хто керує</th>
                                            <th style="width: 26%">Ким керує</th>
                                            <th style="width: 14%">Тип</th>
                                            <th style="width: 12%">Впевненість</th>
                                            <th style="width: 12%">Деталі</th>
                                            <th style="width: 8%"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _rows)
                                        {
                                            <tr>
                                                <td class="fw-medium">@row.FromDisplayName</td>
                                                <td class="fw-medium">@row.ToDisplayName</td>
                                                <td>@BuildRelationTypeLabel(row.RelationType)</td>
                                                <td>@BuildConfidenceLabel(row.Confidence)</td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-secondary btn-sm rounded-0 me-1"
                                                            title="Деталі"
                                                            aria-label="Деталі"
                                                            @onclick="() => OpenDetails(row)">
                                                        ℹ
                                                    </button>
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-danger btn-sm rounded-0"
                                                            title="Видалити зв'язок"
                                                            aria-label="Видалити зв'язок"
                                                            @onclick="() => AskDelete(row.Id)">
                                                        ✕
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (_detailsOpen && _detailsRow is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="directiveDetailsTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 id="directiveDetailsTitle" class="modal-title">Деталі зв'язку</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <div><strong>Хто керує:</strong> @_detailsRow.FromDisplayName</div>
                    <div><strong>Ким керує:</strong> @_detailsRow.ToDisplayName</div>
                    <div><strong>Оновлено:</strong> @ConverterDateTimeExtensions.ToDisplay(_detailsRow.UpdatedAtUtc).ToString("dd.MM.yyyy HH:mm")</div>
                    <div><strong>SourceObservationId:</strong> @(_detailsRow.SourceObservationId?.ToString() ?? "—")</div>
                    <div><strong>Коментар:</strong> @(string.IsNullOrWhiteSpace(_detailsRow.Comment) ? "—" : _detailsRow.Comment)</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm rounded-0" @onclick="CloseDetails">Закрити</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteConfirmOpen && _pendingDeleteId.HasValue)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="directiveDeleteTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 id="directiveDeleteTitle" class="modal-title">Підтвердження видалення</h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            disabled="@_deleteInProgress"
                            @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">Видалити зв'язок керування?</div>
                    <label class="form-label">Причина видалення (коротко)</label>
                    <textarea class="form-control rounded-0"
                              rows="3"
                              @bind="_deleteReason"
                              disabled="@_deleteInProgress"
                              placeholder="Напр. дублікат, помилкова ідентифікація, неактуально"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light btn-sm rounded-0"
                            disabled="@_deleteInProgress"
                            @onclick="CancelDelete">
                        Скасувати
                    </button>
                    <button class="btn btn-danger btn-sm rounded-0"
                            disabled="@(_deleteInProgress || string.IsNullOrWhiteSpace(_deleteReason))"
                            @onclick="ConfirmDeleteAsync">
                        @if (_deleteInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Видалити
                    </button>
                </div>
            </div>
        </div>
    </div>
}
