@page "/registries/actions"
@using Interception.UI.Components.Pages.Registry.InterceptionActions.Drawers
@using Interception.UI.Components.Pages.Registry.Toolbar
@using Interception.UI.Domain
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Регістри — Дії</PageTitle>

<div class="page-shell">

    <RegistriesToolbar ActiveSection="actions">
        <MetaContent>
            @if (_actions is not null)
            {
                <span>Всього: <strong>@_actions.Count</strong></span>
            }
        </MetaContent>
        <ActionsContent>
            <button class="btn btn-outline-light btn-sm" @onclick="ExportDatabaseAsync">
                <i class="bi bi-download me-1"></i>Export DB
            </button>
            <label class="btn btn-outline-warning btn-sm mb-0">
                <i class="bi bi-upload me-1"></i>Import DB
                <InputFile OnChange="ImportDatabaseAsync"
                           accept=".json,application/json"
                           style="display:none" />
            </label>
            <button class="btn btn-success btn-sm" @onclick="OpenCreate">
                <i class="bi bi-plus-lg me-1"></i>Додати дію
            </button>
        </ActionsContent>
    </RegistriesToolbar>

    <div class="page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_actions is null || _actions.Count == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-collection fs-1 d-block mb-2 opacity-25"></i>
                    <div>Дій ще немає</div>
                    <button class="btn btn-success btn-sm mt-2" @onclick="OpenCreate">Додати першу дію</button>
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover table-sm align-middle data-table">
                    <thead>
                        <tr>
                            <th>Назва</th>
                            <th>Опис</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var action in _actions)
                        {
                            <tr>
                                <td class="fw-medium">@action.Name</td>
                                <td class="small">
                                    @if (string.IsNullOrWhiteSpace(action.Description))
                                    {
                                        <span class="opacity-50">—</span>
                                    }
                                    else
                                    {
                                        @action.Description
                                    }
                                </td>
                                <td class="text-end pe-2 text-nowrap">
                                    <button class="btn btn-secondary btn-sm"
                                            title="Редагувати"
                                            @onclick="() => OpenEdit(action)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<ActionFormDrawer @bind-IsOpen="_drawerOpen"
                  EditingAction="_editingAction"
                  OnSaved="LoadAsync" />
