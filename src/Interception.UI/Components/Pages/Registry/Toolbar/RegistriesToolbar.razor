<div class="registry-toolbar flex-shrink-0">
    <div class="toolbar-start d-flex align-items-center gap-2">
        @foreach (var item in NavItems)
        {
            <NavLink class="registry-nav-link d-inline-flex align-items-center justify-content-center"
                     href="@item.Href"
                     Match="@(IsActiveSection(item.Section) ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                     title="@item.Title"
                     aria-label="@item.Title">
                <i class="@item.IconClass"></i>
                <span class="visually-hidden">@item.Title</span>
            </NavLink>
        }
    </div>

    <div class="registry-toolbar-meta toolbar-meta">
        @if (MetaContent is not null)
        {
            @MetaContent
        }
    </div>

    <div class="toolbar-actions d-flex align-items-center gap-2 justify-content-end">
        @if (ActionsContent is not null)
        {
            @ActionsContent
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<RegistryNavItem> NavItems =
    [
        new("divisions", "/registries/divisions", "Підрозділи", "bi bi-broadcast"),
        new("persons", "/registries/persons", "Особи", "bi bi-people"),
        new("roles", "/registries/roles", "Ролі", "bi bi-person-badge"),
        new("actions", "/registries/actions", "Дії", "bi bi-lightning"),
        new("directive-relations", "/registries/directive-relations", "Контур керування", "bi bi-diagram-2")
    ];

    private bool IsActiveSection(string section)
        => string.Equals(ActiveSection, section, StringComparison.OrdinalIgnoreCase);

    private sealed record RegistryNavItem(string Section, string Href, string Title, string IconClass);
}
