@page "/registries/divisions"
@using Interception.UI.Application.Exports.Models
@using Interception.UI.Components.Pages.Registry.Divisions.Drawers
@using Interception.UI.Components.Pages.Registry.Toolbar
@using Interception.UI.Components.Pages.Reports.Divisions

<PageTitle>Регістри — Підрозділи</PageTitle>

<div class="page-shell">

    <RegistriesToolbar ActiveSection="divisions">
        <MetaContent>
            @if (_items is not null)
            {
                <span>Частот: <strong>@_items.Count</strong></span>
            }
        </MetaContent>
        <ActionsContent>
            <button class="btn btn-primary btn-sm" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-repeat me-1"></i>Оновити
            </button>
        </ActionsContent>
    </RegistriesToolbar>

    <div class="page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_items is null || _items.Count == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-broadcast fs-1 d-block mb-2 opacity-25"></i>
                    <div>Частот ще немає</div>
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover table-sm align-middle data-table">
                    <thead>
                        <tr>
                            <th style="width: 26%">Частота</th>
                            <th>Підрозділ</th>
                            <th style="width: 8%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td class="fw-medium text-nowrap">@item.Frequency</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Division))
                                    {
                                        <span class="opacity-50">—</span>
                                    }
                                    else
                                    {
                                        @item.Division
                                    }
                                </td>
                                <td class="text-end pe-2 text-nowrap">
                                    <button class="btn btn-secondary btn-sm"
                                            title="Коригувати"
                                            @onclick="() => OpenEdit(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="d-flex justify-content-end">
        <ExportLauncher Kind="ExportKind.FrequencyDivisionRegistry"
                        Title=".xlsx"
                        ButtonClass="btn btn-outline-secondary btn-sm rounded-0" />
    </div>
   
</div>

<FrequencyDivisionDrawer @bind-IsOpen="_drawerOpen"
                         EditingItem="_editingItem"
                         OnSaved="LoadAsync" />
