@page "/reports/divisions"
@using Interception.UI.Application.Exports.Models
@using Interception.UI.Components.Pages.Reports.Toolbar
@using Interception.UI.Extensions

<PageTitle>Звіти — Підрозділи</PageTitle>

<div class="page-shell">

    <ReportsToolbar ActiveSection="divisions">
        <ActionsContent>          

            <div class="d-flex align-items-end gap-2 flex-nowrap">

                <ExportLauncher Kind="ExportKind.DivisionReport"
                                Title=".xlsx"
                                ButtonClass="btn btn-outline-secondary btn-sm rounded-0"
                                DateFrom="_dateFrom"
                                DateTo="_dateTo" />
                <div>
                    <label class="form-label form-label-sm mb-1">Дата від</label>
                    <input type="date"
                           class="form-control form-control-sm"
                           value="@DateFromStr"
                           @onchange="e => OnDateFromChanged(e.Value?.ToString())" />
                </div>

                <div>
                    <label class="form-label form-label-sm mb-1">Дата до</label>
                    <input type="date"
                           class="form-control form-control-sm"
                           value="@DateToStr"
                           @onchange="e => OnDateToChanged(e.Value?.ToString())" />
                </div>

                <button class="btn btn-success btn-sm"
                        @onclick="LoadAsync"
                        disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-1"></i>
                    }
                    Оновити
                </button>

                <button class="btn btn-light btn-sm"
                        @onclick="ResetPeriodAsync"
                        disabled="@_loading">
                    <i class="bi bi-clock-history me-1"></i>
                    Останні 7 днів
                </button>
            </div>
        </ActionsContent>
    </ReportsToolbar>

    <div class="page-panel">
        @if (_loading)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>Завантаження...
                </div>
            </div>
        }
        else if (_report is null || _report.Groups.Count == 0)
        {
            <div class="panel-scroll d-flex align-items-center justify-content-center page-empty">
                <div class="text-center py-5">
                    <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
                    <div>Даних для звіту немає</div>
                </div>
            </div>
        }
        else
        {
            <div class="panel-scroll p-2 p-md-3">
                @foreach (var group in _report.Groups)
                {
                    <div class="page-panel flex-shrink-0 mb-3">
                        <div class="registry-toolbar flex-shrink-0 rounded-0 border-0 border-bottom px-3">
                            <div class="d-flex align-items-center gap-2 flex-wrap ps-md-1">
                                <span class="fw-semibold">@group.Division</span>

                                @if (group.Frequencies.Count > 0)
                                {
                                    @foreach (var frequency in group.Frequencies)
                                    {
                                        <span class="badge bg-secondary">@frequency</span>
                                    }
                                }
                            </div>

                            <div class="d-flex align-items-center gap-3 flex-wrap justify-content-end ms-auto">
                                <div class="d-flex align-items-center gap-1 small text-muted text-nowrap">
                                    <span>Згадки НВ:</span>
                                    <span class="fw-semibold text-light">@group.UnknownMentionsCount</span>
                                </div>
                                <div class="d-flex align-items-center gap-1 small text-muted text-nowrap">
                                    <span>Групи НВ:</span>
                                    <span class="fw-semibold text-light">@group.UnknownGroupsCount</span>
                                </div>
                            </div>
                        </div>

                        @if (group.People.Count == 0)
                        {
                            <div class="p-3 page-empty">
                                Відомих осіб для цього підрозділу поки немає.
                            </div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="table table-hover table-sm align-middle data-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 38%;">Особа</th>
                                            <th style="width: 42%;">Роль</th>
                                            <th style="width: 20%;" class="text-nowrap">Остання поява</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var person in group.People)
                                        {
                                            <tr>
                                                <td class="fw-medium">@person.Name</td>
                                                <td>@(string.IsNullOrWhiteSpace(person.Role) ? "—" : person.Role)</td>
                                                <td class="text-nowrap">@ConverterDateTimeExtensions.ToDisplay(person.LastSeenAt).ToString("dd.MM.yy HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

</div>
