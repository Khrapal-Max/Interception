<div class="registry-toolbar flex-shrink-0">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (ActiveSection == "divisions")
        {
            <NavLink class="btn btn-success btn-sm" href="/reports/divisions" Match="NavLinkMatch.All">Підрозділи</NavLink>
        }
        else
        {
            <NavLink class="btn btn-outline-secondary btn-sm" href="/reports/divisions">Підрозділи</NavLink>
        }

        @if (ActiveSection == "day-picture")
        {
            <NavLink class="btn btn-success btn-sm" href="/reports/day-picture" Match="NavLinkMatch.All">Картина дня</NavLink>
        }
        else
        {
            <NavLink class="btn btn-outline-secondary btn-sm" href="/reports/day-picture">Картина дня</NavLink>
        }
    </div>

    <div class="registry-toolbar-meta">
        @if (MetaContent is not null)
        {
            @MetaContent
        }
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        @if (ActionsContent is not null)
        {
            @ActionsContent
        }
    </div>
</div>
