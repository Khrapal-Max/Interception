<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TopBarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnDark}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="NavMenuIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BorderBrush" Value="#3F4A55" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#20252B" />
        <Setter Property="Foreground" Value="#E6ECF2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A3036" />
                <Setter Property="BorderBrush" Value="#586573" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#313941" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavMenuIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="HomeTileBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#E8EDF2" />
        <Setter Property="BorderBrush" Value="#45515D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#2B3239" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.92" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeTileObservationsStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#325067" />
        <Setter Property="BorderBrush" Value="#44749D" />
    </Style>

    <Style x:Key="HomeTileCandidatesStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#5A4769" />
        <Setter Property="BorderBrush" Value="#8F63A7" />
    </Style>

    <Style x:Key="HomeTileLinkMapStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#2F5D66" />
        <Setter Property="BorderBrush" Value="#4A94A1" />
    </Style>

    <Style x:Key="HomeTileReportsStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#66522F" />
        <Setter Property="BorderBrush" Value="#9F7A34" />
    </Style>

    <Style x:Key="HomeTileDayStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#4E5B2C" />
        <Setter Property="BorderBrush" Value="#7FA03B" />
    </Style>

    <Style x:Key="HomeTileRegistryStyle" TargetType="Button" BasedOn="{StaticResource HomeTileBaseStyle}">
        <Setter Property="Background" Value="#3A415B" />
        <Setter Property="BorderBrush" Value="#6679B2" />
    </Style>

    <Style x:Key="MenuBlockTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#E8EDF2" />
    </Style>

    <Style x:Key="MenuBlockSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="#CFD6DD" />
    </Style>

    <Style x:Key="ObservationToolbarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="Background" Value="#2F6D9B" />
        <Setter Property="BorderBrush" Value="#235376" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3E7EA8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#245A81" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ObservationSecondaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ObservationToolbarButtonStyle}">
        <Setter Property="Background" Value="#7C4D9E" />
        <Setter Property="BorderBrush" Value="#5D3977" />
    </Style>

    <Style x:Key="ModalWindowBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="640" />
        <Setter Property="MaxHeight" Value="660" />
        <Setter Property="Background" Value="#FFFDFEFF" />
        <Setter Property="BorderBrush" Value="#5A77A8" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
