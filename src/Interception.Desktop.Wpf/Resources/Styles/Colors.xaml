<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.TopBar">#1F2937</Color>
    <Color x:Key="Color.Sidebar">#111827</Color>
    <Color x:Key="Color.SidebarHover">#1F2A3D</Color>
    <Color x:Key="Color.ContentBackground">#F3F4F6</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Border">#E5E7EB</Color>
    <Color x:Key="Color.PrimaryText">#111827</Color>
    <Color x:Key="Color.SecondaryText">#4B5563</Color>

    <SolidColorBrush x:Key="Brush.TopBar" Color="{StaticResource Color.TopBar}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="{StaticResource Color.ContentBackground}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.PrimaryText" Color="{StaticResource Color.PrimaryText}" />
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="{StaticResource Color.SecondaryText}" />
    <SolidColorBrush x:Key="Brush.OnDark" Color="White" />
</ResourceDictionary>
