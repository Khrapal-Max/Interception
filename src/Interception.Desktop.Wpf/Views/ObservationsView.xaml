<UserControl x:Class="Interception.Desktop.Wpf.Views.ObservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding Description}" Style="{StaticResource PageDescriptionTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
