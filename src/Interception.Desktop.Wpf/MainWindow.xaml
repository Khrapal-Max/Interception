<Window x:Class="Interception.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Interception.Desktop.Wpf.ViewModels"
        xmlns:views="clr-namespace:Interception.Desktop.Wpf.Views"
        Title="Interception Desktop"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ObservationsViewModel}">
            <views:ObservationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AnalyticsViewModel}">
            <views:AnalyticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RegistriesViewModel}">
            <views:RegistriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource Brush.TopBar}"
                BorderBrush="#263449"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock Text="Interception"
                           Style="{StaticResource AppTitleTextStyle}"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Налаштування" Style="{StaticResource TopBarButtonStyle}" Command="{Binding NavigateSettingsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Sidebar}" Padding="8,10">
            <StackPanel>
                <Button Style="{StaticResource NavMenuIconButtonStyle}" Command="{Binding NavigateHomeCommand}">
                    <TextBlock Text="⌂" Style="{StaticResource NavMenuIconTextStyle}" />
                </Button>
                <Button Style="{StaticResource NavMenuIconButtonStyle}" Command="{Binding NavigateObservationsCommand}">
                    <TextBlock Text="▦" Style="{StaticResource NavMenuIconTextStyle}" />
                </Button>
                <Button Style="{StaticResource NavMenuIconButtonStyle}" Command="{Binding NavigateAnalyticsCommand}">
                    <TextBlock Text="▤" Style="{StaticResource NavMenuIconTextStyle}" />
                </Button>
                <Button Style="{StaticResource NavMenuIconButtonStyle}" Command="{Binding NavigateReportsCommand}">
                    <TextBlock Text="☰" Style="{StaticResource NavMenuIconTextStyle}" />
                </Button>
                <Button Style="{StaticResource NavMenuIconButtonStyle}" Command="{Binding NavigateRegistriesCommand}">
                    <TextBlock Text="⎚" Style="{StaticResource NavMenuIconTextStyle}" />
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Padding="16">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="Desktop shell v0.2" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
